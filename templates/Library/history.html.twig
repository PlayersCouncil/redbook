{#
   A library's History tab (Ketura, 2026-11-09): its revisions, newest first, each with who
   made it and how, what changed, and a Restore that puts the library back as that revision
   had it (as a new revision, so a restore can be undone too). The deckbuilder's History table.
   Variables: library, revisions (LibraryRevision[]), revision_decklists (id => PublishedDeck)
#}
{% macro decklist(id, decklists) %}
    {%- set d = decklists[id] ?? null -%}
    {%- if d -%}<a href="{{ path('decklist_detail', {decklist_id: d.id, decklist_name: d.nameCanonical}) }}">{{ d.name }}</a>
    {%- else -%}<span class="text-muted">{{ 'library.history.deleted' | trans({'%id%': id}) }}</span>{%- endif -%}
{% endmacro %}
{% import _self as h %}
<div class="rb-history" id="library-history">
    <p class="text-muted small">{{ 'library.history.intro' | trans }}</p>
    {% if revisions is empty %}
        <p class="rb-history-none">{{ 'library.history.none' | trans }}</p>
    {% else %}
        <table class="table table-condensed rb-history-table rb-lib-history">
            <thead>
            <tr>
                <th>{{ 'decks.history.columns.date' | trans }}</th>
                <th>{{ 'decks.history.columns.changes' | trans }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for revision in revisions %}
                {% set c = revision.changes ?? {} %}
                {% set who = revision.user ? revision.user.displayName : null %}
                <tr data-revision="{{ revision.id }}">
                    <td class="rb-nowrap">{{ revision.dateCreation | date('Y-m-d H:i') }}</td>
                    <td>
                        <div class="rb-history-edit">
                            {%- if revision.kind == 'revert' -%}
                                {% set to = revisions | filter(r => r.id == c.revision) | first %}
                                {{ 'library.history.kind.revert' | trans({'%date%': to ? to.dateCreation | date('Y-m-d H:i') : '?'}) }}
                            {%- elseif revision.kind == 'promote' and library.promotedFrom -%}
                                {{ 'library.history.kind.promote' | trans }}
                                <a href="{{ path('library_view', {public_id: library.promotedFrom.publicId, library_name: library.promotedFrom.nameCanonical}) }}">{{ library.promotedFrom.name }}</a>
                            {%- else -%}
                                {{ ('library.history.kind.' ~ revision.kind) | trans }}
                            {%- endif -%}
                            {% if who %} <span class="rb-history-by">{{ 'library.history.by' | trans({'%name%': who}) }}</span>{% endif %}
                        </div>
                        <ul class="list-unstyled rb-history-changes">
                            {% for id in c.added ?? [] %}<li>+ {{ h.decklist(id, revision_decklists) }}</li>{% endfor %}
                            {% for id in c.removed ?? [] %}<li>&minus; {{ h.decklist(id, revision_decklists) }}</li>{% endfor %}
                            {% for id in c.annotated ?? [] %}<li>{{ 'library.history.annotated' | trans }}: {{ h.decklist(id, revision_decklists) }}</li>{% endfor %}
                            {% if c.reordered ?? false %}<li>{{ 'library.history.reordered' | trans }}</li>{% endif %}
                            {% if c.fields ?? [] %}<li>{{ 'library.history.changed' | trans }}: {{ c.fields | map(f => ('library.history.field.' ~ f) | trans) | join(', ') }}</li>{% endif %}
                            {% for id in c.missing ?? [] %}<li class="rb-history-changed">{{ 'library.history.not_restored' | trans }}: {{ h.decklist(id, revision_decklists) }}</li>{% endfor %}
                            {% if revision.kind != 'baseline' and revision.kind != 'revert' and c is empty %}<li class="text-muted">{{ 'library.history.entries' | trans({'%count%': revision.snapshot.entries | length}) }}</li>{% endif %}
                        </ul>
                    </td>
                    <td class="text-right">
                        {% if loop.first %}
                            <span class="text-muted small">{{ 'library.history.current' | trans }}</span>
                        {% else %}
                            <form method="post" action="{{ path('library_revert', {library_uuid: library.uuid}) }}" class="rb-inline-form" data-confirm="{{ 'library.history.restore_confirm' | trans({'%date%': revision.dateCreation | date('Y-m-d H:i')}) }}">
                                <input type="hidden" name="revision" value="{{ revision.id }}"><input type="hidden" name="token" value="{{ csrf_token('library') }}">
                                <button type="submit" class="rb-btn rb-btn-small">{{ 'library.history.restore' | trans }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
