{# Culture and side (file name kept from ThronesDB's faction line) #}
<div class="card-culture">
    {% if card.culture_code is defined and card.culture_code %}
        <span class="culture-symbol culture-{{ card.culture_code }}"></span>
        <span class="card-culture-name">{{ card.culture_name }}</span>.
    {% endif %}
    {% if card.side %}
        <span class="card-side">{{ ('side.' ~ card.side) | trans }}</span>.
    {% endif %}
</div>
