{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}
{% block body %}
    <div class="main white container">
        {% include 'alerts.html.twig' %}
        <h1>{{ 'claim.title' | trans({'%name%': historic.displayName}) }}</h1>
        <p>{{ macros.username(historic) }}</p>
        {% if pending %}
            <div class="alert alert-info">{{ 'claim.pending' | trans }}</div>
        {% else %}
            <p>{{ 'claim.intro' | trans({'%name%': historic.displayName, '%source%': historic.historicSource, '%count%': nb_decklists}) }}</p>
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('claim' ~ historic.id) }}">
                <div class="form-group">
                    <label for="message">{{ 'claim.message' | trans }}</label>
                    <textarea class="form-control" id="message" name="message" rows="4" maxlength="2000"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">{{ 'claim.submit' | trans }}</button>
            </form>
        {% endif %}
    </div>
{% endblock %}
