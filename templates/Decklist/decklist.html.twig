{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/ui.decklist.js') }}"></script>
    <script type="text/javascript">
      var Commenters = {{ commenters|json_encode|raw }};
      app.deck.init({{ decklist|json_encode|raw }});
      app.user.params.decklist_id = {{ decklist.id }};
    </script>
{% endblock %}

{% block body %}
    <div class="container">

        {% include 'alerts.html.twig' %}
        {% if decklist.unverified %}
            <div class="alert alert-warning rb-review-note">
                {{ 'decklist.review.unverified_note' | trans }}
                {% if is_granted('ROLE_HISTORIAN') and decklist.parent and decklist.user.historic %}
                    <a class="btn btn-xs btn-default" target="_blank" href="{{ path('deck_edit', {deck_uuid: decklist.parent.uuid}) }}">{{ 'historian.review.open' | trans }}</a>
                {% endif %}
            </div>
        {% elseif decklist.verified and decklist.reviewedBy %}
            <p class="small text-muted text-right rb-review-note">{{ 'decklist.review.verified_by' | trans({'%name%': decklist.reviewedBy.displayName, '%date%': decklist.reviewedAt | date('Y-m-d')}) }}</p>
        {% endif %}
        <div class="row title bg-faction">
            <div class="col-xs-12">
                <h1 class="decklist-name text-center">
                    {{ decklist.name }}
                    <span class="dropdown">
                  <button class="btn btn-default dropdown-toggle" type="button"
                          data-toggle="dropdown" aria-haspopup="true" aria-expanded="true" id="dropdownVersions">
                    {{ decklist.version }}
                    <span class="caret"></span>
                  </button>
                  <ul class="dropdown-menu" aria-labelledby="dropdownVersions">
                      <li class="dropdown-header">{{ 'decklist.view.versions' | trans }}</li>
                      {% for other_decklist in versions %}
                        <li class="{% if other_decklist.id == decklist.id %}disabled{% endif %}">
                              <a href="{{ path('decklist_detail', { 'decklist_id': other_decklist.id, 'decklist_name': other_decklist.nameCanonical|e('url') }) }}">
                                  {{ other_decklist.version }}
                              </a>
                          </li>
                    {% endfor %}
                  </ul>
                </span>
                </h1>
            </div>
            <div class="col-xs-12">
                <div class="social">
                    <div class="pull-right">
                        <span class="hidden-xs">{{ 'decklist.view.published' | trans }}: </span>
                        <time datetime="{{ decklist.dateCreation|date('c') }}">{{ decklist.dateCreation|date('M d, Y') }}</time>
                        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                            <span class="social-icons">
                                <a id="social-icon-like" href="#" class="social-icon-like" data-toggle="tooltip" data-placement="bottom"
                                   title="{{ 'decklist.view.social.like' | trans }}">
                                    <span class="fas fa-heart"></span> <span class="num">{{ decklist.nbVotes }}</span>
                                </a>
                                <a id="social-icon-favorite" href="#" class="social-icon-favorite" data-toggle="tooltip" data-placement="bottom"
                                   title="{{ 'decklist.view.social.favorite' | trans }}">
                                    <span class="fas fa-star"></span> <span class="num">{{ decklist.nbFavorites }}</span>
                                </a>
                                <a id="social-icon-comment" href="#comment-form" class="social-icon-comment" data-toggle="tooltip"
                                   data-placement="bottom" title="{{ 'decklist.view.social.comment' | trans }}">
                                    <span class="fas fa-comment"></span> <span class="num">{{ decklist.nbComments }}</span>
                                </a>
                                <span class="social-icon-version" data-toggle="tooltip" data-placement="bottom"
                                      title="{{ 'decklist.view.social.version' | trans }}">
                                    <span class="fas fa-code-branch"></span> <span class="num">{{ decklist.version }}</span>
                                </span>
                            </span>
                        {% else %}
                            {{ macros.decklist_social_icons(decklist) }}
                        {% endif %}
                    </div>
                    {% if duplicate %}
                        {% set duplink %}
                            <a href="{{ path('decklist_detail', { 'decklist_id': duplicate.id, 'decklist_name': duplicate.nameCanonical|e('url') }) }}">
                                {{ duplicate.name }} {{ duplicate.version }}
                            </a>
                        {% endset %}
                        <small>{{ 'decklist.view.duplicate' | trans({'%duplicate%': duplink}) | raw }}</small>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="main white container">
        <div class="row">
            <div class="col-md-6">
                <p>{% include 'Deck/completeness-label.html.twig' with {deck: decklist} %}</p>
                {% include 'Deck/validation.html.twig' with {deck: decklist, title: 'decklist.view.problems' | trans} %}
                {% include 'Deck/deck-content.html.twig' with {deck: decklist} %}
                {% include 'Decklist/plays.html.twig' %}
                {% include 'Builder/deck-charts.html.twig' %}
                {% include 'Builder/draw-simulator.html.twig' %}
                {% include 'Decklist/table-predecessor.html.twig' %}
                {% include 'Decklist/table-successor.html.twig' %}
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-12">
                        <div class="pull-right btn-group"
                             role="group">{% include 'Decklist/toolbar.html.twig' %}</div>
                    </div>
                    <div class="col-md-12">
                        {% include 'Decklist/author-and-description.html.twig' %}
                    </div>
                    {% if decklist.source %}
                        <div class="col-md-12">{% include 'Decklist/source.html.twig' with {source: decklist.source} %}</div>
                    {% endif %}
                    <div class="col-md-12">
                        {% include 'Decklist/comments.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% include 'Decklist/export-modal.html.twig' %}
    {% include 'Decklist/delete-modal.html.twig' %}
    {% include 'Modale/odds.html.twig' %}
    {% include 'Decklist/compare-modal.html.twig' %}
{% endblock %}
