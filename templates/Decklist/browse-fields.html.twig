{#
   The search and filters of a list of decks (Ketura, 2026-11-07): the decklists page, and My
   Decks, which adds which of the user's decks to include (on its My Decks tab; greyed out, but
   kept, on My Favorites) and dates them by their last change.
   Variables: filters, formats [{code, name, count}], cultures, cards, list_route (and its
   list_params, a library's Build tab's uuid); my_decks
#}
{% set my_decks = my_decks ?? false %}
{% import 'Decklist/macros.html.twig' as m %}
{% set f = filters %}
{% set active = f | filter((v, k) => k not in ['sort', 'limit', 'tab']) | length %}
{# My Decks dates a deck by its last change; a favourite, like any decklist, by its publication #}
{% set date_label = my_decks and (f.tab ?? 'decks') == 'decks' ? 'decks.browse.changed' : 'decklist.browse.submitted' %}
        {# the format first: it's what anyone sets first (Ketura, 2026-11-06) #}
        <label class="rb-field rb-field-format">
            <span>{{ 'decklist.browse.format' | trans }}</span>
            <select name="format" class="form-control input-sm" data-autosubmit>
                <option value="">{{ 'decklist.browse.any_format' | trans }}</option>
                {% for format in formats %}
                    <option value="{{ format.code }}"{% if (f.format ?? '') == format.code %} selected{% endif %}>{{ format.name }} ({{ format.count }})</option>
                {% endfor %}
            </select>
        </label>

        <div class="rb-browse-search">
            <label class="rb-field">
                <span>{{ 'decklist.browse.name' | trans }}</span>
                <input type="search" name="name" class="form-control input-sm" value="{{ f.name ?? '' }}">
            </label>
            <label class="rb-field">
                <span>{{ 'decklist.browse.author' | trans }}</span>
                <input type="search" name="author" class="form-control input-sm" value="{{ f.author ?? '' }}">
            </label>
            <div class="rb-field rb-field-cards">
                <label for="browse-card">{{ 'decklist.browse.cards' | trans }}</label>
                <div class="rb-card-picks form-control input-sm" id="browse-cards">
                    {% for card in cards %}
                        <span class="rb-card-pick"><input type="hidden" name="cards[]" value="{{ card.code }}">{{ card.fullName }}<button type="button" aria-label="{{ 'decklist.browse.remove' | trans }}">&times;</button></span>
                    {% endfor %}
                    <input type="text" id="browse-card" autocomplete="off" placeholder="{{ 'decklist.browse.cards_hint' | trans }}">
                </div>
            </div>
            {# tags: typed, picked from the drawer under the field, or clicked on a deck's row
               (Ketura, 2026-11-06/07); a deck has them all. The drawer offers the public
               decklists' tags, and on My Decks your decks' first. #}
            {% set tags_url = my_decks and (f.tab ?? 'decks') == 'decks' ? path('deck_tags') : path('decklist_tags') %}
            {#
               Tags Included and Tags Excluded (Ketura, 2026-11-08); Excluded starts with Retired
               and Shireposting (PublishedDeckManager::DEFAULT_EXCLUDED_TAGS), and a list leaves
               them out unless they're taken off
            #}
            {% set xtags = f.xtags is defined ? f.xtags | filter(t => t) : ['Retired', 'Shireposting'] %}
            {% for field in [{name: 'tags', label: 'decklist.browse.tags_in', tags: f.tags ?? [], id: 'browse-tag'}, {name: 'xtags', label: 'decklist.browse.tags_out', tags: xtags, id: 'browse-xtag'}] %}
                <div class="rb-field rb-field-tags" data-tag-field="{{ field.name }}"{% if field.name == 'xtags' %} data-default="Retired,Shireposting"{% endif %}>
                    <label for="{{ field.id }}">{{ field.label | trans }}</label>
                    <div class="rb-card-picks rb-tag-picks form-control input-sm"{% if loop.first %} id="browse-tags"{% endif %} data-tags-url="{{ tags_url }}">
                        {% for tag in field.tags %}
                            <span class="rb-card-pick rb-tag-pick"><input type="hidden" name="{{ field.name }}[]" value="{{ tag }}">{{ tag }}<button type="button" aria-label="{{ 'decklist.browse.remove' | trans }}">&times;</button></span>
                        {% endfor %}
                        <input type="text" id="{{ field.id }}" class="rb-tag-input" autocomplete="off" placeholder="{{ 'decklist.browse.tags_hint' | trans }}" role="combobox" aria-expanded="false" aria-controls="{{ field.id }}-suggest">
                    </div>
                    <div class="rb-tag-suggest" id="{{ field.id }}-suggest" role="listbox" hidden></div>
                </div>
            {% endfor %}
        </div>

        <div class="rb-browse-filters">
            {# when the deck was submitted, picked from a calendar (Ketura, 2026-11-06) #}
            <div class="rb-field rb-field-dates">
                <span>{{ date_label | trans }}</span>
                <div class="rb-dates">
                    <input type="date" name="from" class="form-control input-sm" min="2001-01-01" value="{{ f.from ?? '' }}" aria-label="{{ date_label | trans }}: {{ 'decklist.browse.from' | trans }}" data-autosubmit>
                    <span>–</span>
                    <input type="date" name="to" class="form-control input-sm" min="2001-01-01" value="{{ f.to ?? '' }}" aria-label="{{ date_label | trans }}: {{ 'decklist.browse.to' | trans }}" data-autosubmit>
                </div>
            </div>
            <div class="rb-field">
                <span>{{ 'decklist.browse.show' | trans }}</span>
                <div class="rb-toggles" data-default="whole,free_peoples,shadow">
                    {% for kind in ['whole', 'free_peoples', 'shadow'] %}
                        <label class="rb-toggle rb-toggle-{{ kind }}" title="{{ ('decklist.browse.kind_title.' ~ kind) | trans }}">
                            <input type="checkbox" name="kind[]" value="{{ kind }}" data-autosubmit{% if f.kind is not defined or kind in f.kind %} checked{% endif %}>
                            <span>{{ ('decklist.browse.kind.' ~ kind) | trans }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>
            {# My Decks: the user's decks by who can see them (Ketura, 2026-11-07); the tab it's on #}
            {% if my_decks %}
                {% set favorites_tab = (f.tab ?? 'decks') == 'favorites' %}
                <input type="hidden" name="tab" value="{{ f.tab ?? 'decks' }}" data-default="decks">
                <div class="rb-field rb-field-include{% if favorites_tab %} is-off{% endif %}"{% if favorites_tab %} title="{{ 'decks.browse.include_off' | trans }}"{% endif %}>
                    <span>{{ 'decks.browse.include' | trans }}</span>
                    <div class="rb-toggles" data-default="private,hidden,published">
                        {% for show in ['private', 'hidden', 'published'] %}
                            <label class="rb-toggle rb-toggle-{{ show }}" title="{{ ('decks.browse.include_title.' ~ show) | trans }}">
                                <input type="checkbox" name="show[]" value="{{ show }}" data-autosubmit{% if show in (f.show ?? ['private', 'hidden', 'published']) %} checked{% endif %}{% if favorites_tab %} tabindex="-1"{% endif %}>
                                <span>{{ ('decks.browse.show.' ~ show) | trans }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="rb-browse-cultures">
            <span class="rb-browse-label">{{ 'decklist.browse.cultures' | trans }}</span>
            {# Gollum ends the Free Peoples, and Men, Orc and Uruk-hai the Shadow, in black for
               now (Ketura, 2026-11-06) #}
            {% set late = ['gollum', 'men', 'orc', 'uruk_hai'] %}
            {% for side in ['free_peoples', 'shadow'] %}
                {% if not loop.first %}<span class="rb-culture-sep"></span>{% endif %}
                {% set sided = cultures | filter(c => c.side == side) %}
                {% for culture in (sided | filter(c => c.code not in late)) | merge(sided | filter(c => c.code in late)) %}
                    <label class="rb-culture-pick" title="{{ culture.name }}">
                        <input type="checkbox" name="culture[]" value="{{ culture.code }}" data-autosubmit{% if culture.code in (f.culture ?? []) %} checked{% endif %}>
                        <span>{{ m.culture_icon(culture, null, '#111') }}</span>
                    </label>
                {% endfor %}
            {% endfor %}
        </div>

        {# filters the pane has no field for, set by a link (the old tabs, Back after deleting a
           deck): shown so they can be seen and dropped (Ketura, 2026-11-06) #}
        {% set also = [] %}
        {% if f.event is defined %}{% set also = also | merge([{name: 'event', value: f.event, label: 'decklist.browse.also_event' | trans({'%name%': f.event})}]) %}{% endif %}
        {% for key in ['played', 'legal', 'mine', 'favorites'] | filter(k => f[k] is defined) %}
            {% set also = also | merge([{name: key, value: 1, label: ('decklist.browse.also_' ~ key) | trans}]) %}
        {% endfor %}
        {% if also %}
            <div class="rb-field rb-browse-also" title="{{ 'decklist.browse.also_title' | trans }}">
                <span>{{ 'decklist.browse.also' | trans }}</span>
                <div class="rb-card-picks-row">
                    {% for item in also %}
                        <span class="rb-card-pick"><input type="hidden" name="{{ item.name }}" value="{{ item.value }}">{{ item.label }}<button type="button" aria-label="{{ 'decklist.browse.remove' | trans }}">&times;</button></span>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div class="rb-browse-submit">
            <span class="rb-browse-actions">
                {# every filter back to its default; the sort, page size and tab stay (Ketura, 2026-11-07) #}
                <button type="submit" class="btn btn-primary btn-sm"><span class="fas fa-search"></span> {{ 'decklist.browse.search' | trans }}</button>
                <a href="{{ list_path(list_route, (list_params ?? {}) | merge(f | filter((v, k) => k in ['sort', 'limit', 'tab']))) }}" class="btn btn-default btn-sm rb-browse-clear{% if not active %} is-idle{% endif %}"><span class="fas fa-undo"></span> {{ 'decklist.browse.reset' | trans }}</a>
            </span>
        </div>
