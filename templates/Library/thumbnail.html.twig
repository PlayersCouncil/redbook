{# A library's thumbnail (Ketura, 2026-11-08): its own card, framed by the card's template; else
   its first deck's thumbnail; else a book. Variables: library #}
{% set card = library.thumbnailCard %}
{% if card and card.imageUrl %}
    <span class="rb-thumb rb-thumb-card rb-thumb-tpl-{{ card.thumbnailTemplate }}"><img src="{{ card.imageUrl }}" alt="{{ card.fullName }}" loading="lazy"></span>
{% elseif library.firstAvailableDecklist %}
    {% include 'Decklist/thumbnail.html.twig' with {decklist: library.firstAvailableDecklist} %}
{% else %}
    <span class="rb-thumb rb-thumb-empty" aria-hidden="true"><span class="fas fa-book"></span></span>
{% endif %}
