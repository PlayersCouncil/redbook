{% extends 'base.html.twig' %}

{% block body %}

    <div class="jumbotron" id="no-deck-available">
        <div class="main white container">

            {% include 'alerts.html.twig' %}
            {% include 'Builder/no-decks-text.'~ app.request.locale ~'.html.twig' %}
        </div>
    </div>
    <div style="text-align:center">
        {# both lead to New Deck, which imports too (Ketura, 2026-11-08) #}
        <a href="{{ path('deck_buildform') }}" class="btn btn-default btn-lg"><span
                    class="fas fa-plus"></span> {{ 'decks.form.build' | trans }}</a>
        <a href="{{ path('deck_import') }}" class="btn btn-default btn-lg"><span
                    class="fas fa-file-import"></span> {{ 'forms.import' | trans }}</a>
    </div>

{% endblock %}
