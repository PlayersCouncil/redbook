{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}

{#
 The deckbuilder (Ketura's region design, 2026-11-02): deck information and the deck
 list on the left, the card filters and pool on the right with Notes, Test draw,
 Charts and History as tabs above them.
#}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/app.card_terms.js') }}"></script>
    <script src="{{ asset('js/app.deck_editor.js') }}"></script>
    <script src="{{ asset('js/app.pool.js') }}"></script>
    <script src="{{ asset('js/ui.deckedit.js') }}"></script>
    <script type="text/javascript">
      app.deck && app.deck.init({{ deck|json_encode|raw }});
      app.deck_history && app.deck_history.init({{ deck.history|json_encode|raw }});
      app.deckbuilder_page = {{ {
          published: deck.children|length > 0,
          publish_url: path('deck_publish_form', {deck_uuid: deck.uuid}),
          view_url: url('deck_view', {deck_uuid: deck.uuid}),
          historian: is_granted('ROLE_HISTORIAN'),
          review: review
      }|json_encode|raw }};
    </script>
{% endblock %}

{% block body %}
    <div class="main white container rb-builder">
        {% include 'alerts.html.twig' %}
        <div class="row rb-builder-row">
            <!-- Left: deck information, then the deck -->
            <div class="col-md-6 rb-col-left">
                <section class="rb-info" id="deck-info" aria-label="{{ 'deckbuilder.info.label' | trans }}">
                    <div class="rb-draft-banner" id="draft-banner" hidden></div>

                    <label class="rb-field rb-name-field">
                        <span>{{ 'deckbuilder.info.name' | trans }}</span>
                        <input type="text" id="deck-name" value="{{ deck.name }}" autocomplete="off">
                    </label>

                    <div class="rb-format-row">
                        <label class="rb-field rb-format-field">
                            <span>{{ 'deck.target_format' | trans }}</span>
                            <select id="deck-format">
                                <option value="">{{ 'deckbuilder.info.choose_format' | trans }}</option>
                                {% set listed = deck.targetFormat == '' %}
                                {% for f in formats %}
                                    <option value="{{ f.code }}"{% if f.code == deck.targetFormat %} selected{% set listed = true %}{% endif %}>{{ f.name }}</option>
                                {% endfor %}
                                {% if not listed %}<option value="{{ deck.targetFormat }}" selected>{{ format ? format.name : deck.targetFormat }}</option>{% endif %}
                            </select>
                        </label>
                        <button type="button" class="rb-btn" id="btn-suggest-format" hidden>{{ 'deck.suggest_format' | trans }}</button>
                        <button type="button" class="rb-btn" id="btn-convert-pc" hidden title="{{ 'deck.convert_hint' | trans }}"></button>
                        <div class="rb-popover" id="format-suggestions" role="dialog" aria-label="{{ 'deckbuilder.info.suggestions' | trans }}" hidden></div>
                    </div>

                    <div class="rb-validation" id="deck-validation" role="status" aria-live="polite"></div>

                    <div class="rb-actions">
                        <button type="button" class="rb-btn rb-btn-primary" id="btn-save">{{ 'deckbuilder.info.save' | trans }}</button>
                        <button type="button" class="rb-btn" id="btn-revert">{{ 'deckbuilder.info.revert' | trans }}</button>
                        <div class="rb-menu-wrap">
                            <button type="button" class="rb-btn" id="btn-visibility" aria-haspopup="menu" aria-expanded="false"></button>
                            <div class="rb-menu" id="menu-visibility" role="menu" hidden>
                                <button type="button" role="menuitemradio" data-visibility="private"><strong>{{ 'deckbuilder.visibility.private' | trans }}</strong><span>{{ 'deckbuilder.visibility.private_hint' | trans }}</span></button>
                                <button type="button" role="menuitemradio" data-visibility="hidden"><strong>{{ 'deckbuilder.visibility.hidden' | trans }}</strong><span>{{ 'deckbuilder.visibility.hidden_hint' | trans }}</span></button>
                                <button type="button" role="menuitemradio" data-visibility="published"><strong>{{ 'deckbuilder.visibility.published' | trans }}</strong><span>{{ 'deckbuilder.visibility.published_hint' | trans }}</span></button>
                            </div>
                        </div>
                        <div class="rb-menu-wrap">
                            <button type="button" class="rb-btn" id="btn-more" aria-haspopup="menu" aria-expanded="false">{{ 'deckbuilder.info.more' | trans }} <span aria-hidden="true">&#9662;</span></button>
                            <div class="rb-menu" id="menu-more" role="menu" hidden>
                                <button type="button" role="menuitem" data-action="copy">{{ 'deckbuilder.more.copy' | trans }}</button>
                                <button type="button" role="menuitem" data-action="link">{{ 'deckbuilder.more.link' | trans }}</button>
                                <button type="button" role="menuitem" data-action="export-gemp">{{ 'deckbuilder.more.export_gemp' | trans }}</button>
                                <button type="button" role="menuitem" data-action="export-text">{{ 'deckbuilder.more.export_text' | trans }}</button>
                                <button type="button" role="menuitem" data-action="history">{{ 'deckbuilder.more.history' | trans }}</button>
                                <hr>
                                <button type="button" role="menuitem" data-action="delete" class="rb-danger">{{ 'deckbuilder.more.delete' | trans }}</button>
                            </div>
                        </div>
                        <span class="rb-save-status" id="save-status" aria-live="polite"></span>
                    </div>

                    {% if review %}
                        {% set source = archive_decklist.source %}
                        <section class="rb-review is-{{ review.status }}" id="review-panel" aria-labelledby="review-title">
                            <div class="rb-review-head">
                                <h3 id="review-title">{{ 'historian.review.panel_title' | trans }}</h3>
                                <span class="rb-review-status" id="review-status"></span>
                                <a href="{{ review.url }}" target="_blank" rel="noopener" class="rb-review-link">{{ 'historian.review.view_published' | trans }}</a>
                            </div>
                            <ul class="rb-review-flags" id="review-flags"></ul>
                            <div class="rb-actions">
                                <button type="button" class="rb-btn rb-btn-primary" id="btn-save-verify">{{ 'historian.review.save_verify' | trans }}</button>
                                <span class="rb-review-hint">{{ 'historian.review.save_verify_hint' | trans }}</span>
                            </div>
                            {% if source %}
                                <details class="rb-review-original"{% if review.status != 'verified' %} open{% endif %}>
                                    <summary>{{ 'historian.review.original' | trans({'%source%': source.source}) }}
                                        <a href="{{ source.sourceUrl }}" target="_blank" rel="nofollow noopener">{{ 'decklist.source.original' | trans }}</a>{% if source.archiveUrl %}
                                        &middot; <a href="{{ source.archiveUrl }}" target="_blank" rel="nofollow noopener">{{ 'decklist.source.archived' | trans }}</a>{% endif %}</summary>
                                    {% if source.unresolved | length %}
                                        <div class="rb-review-unresolved">
                                            <strong>{{ 'historian.review.unresolved' | trans }}</strong>
                                            <ul>{% for line in source.unresolved %}<li><code>{{ line.line }}</code>{% if line.count is defined and line.count > 1 %} &times;{{ line.count }}{% endif %}{% if line.section is defined and line.section %} <span class="text-muted">{{ line.section }}</span>{% endif %}{% if line.reason is defined and line.reason %} <em>({{ line.reason }})</em>{% endif %}</li>{% endfor %}</ul>
                                        </div>
                                    {% endif %}
                                    {% if source.formatGuess %}
                                        <p class="small">{{ 'decklist.source.format_guessed' | trans({'%format%': archive_decklist.targetFormat}) }} {{ source.formatGuess.reasons | join('; ') }}.</p>
                                    {% endif %}
                                    <pre class="rb-review-raw">{{ source.rawDecklist }}</pre>
                                </details>
                            {% endif %}
                        </section>
                    {% endif %}

                    <details class="rb-historic" id="historic-section"{% if review %} open{% endif %}>
                        <summary>{{ 'deckbuilder.historic.title' | trans }} <span class="rb-historic-badge" hidden>{{ 'deckbuilder.historic.badge' | trans }}</span></summary>
                        <label class="rb-check"><input type="checkbox" id="historic-on"> {{ 'deckbuilder.historic.is_historic' | trans }}</label>
                        <fieldset id="historic-fields" disabled>
                            {% set f = deck.historic ?? {} %}
                            <label class="rb-field rb-wide"><span>{{ 'deckbuilder.historic.author' | trans }}</span><input type="text" data-historic="author" value="{{ f.author ?? '' }}" placeholder="{{ app.user.username }}"></label>
                            <label class="rb-field"><span>{{ 'deckbuilder.historic.source' | trans }}</span>
                                <select data-historic="source">
                                    <option value="">{{ 'deckbuilder.historic.choose' | trans }}</option>
                                    {% set sources = {'decipher-forums': 'Decipher forums', 'decktech': 'DeckTech.net', 'gpn': 'GamePlayersNetwork', 'lotr-online-tcg-forums': 'LOTR Online TCG forums', 'tlhh': 'The Last Homely House', 'other': 'deckbuilder.historic.other' | trans} %}
                                    {% if f.source is defined and f.source and sources[f.source] is not defined %}<option value="{{ f.source }}" selected>{{ f.source }}</option>{% endif %}
                                    {% for code, label in sources %}
                                        <option value="{{ code }}"{% if (f.source ?? '') == code %} selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label class="rb-field"><span>{{ 'deckbuilder.historic.date_used' | trans }}</span><input type="text" data-historic="date_used" value="{{ f.date_used ?? '' }}" placeholder="{{ 'deckbuilder.historic.date_hint' | trans }}"></label>
                            <label class="rb-field rb-wide"><span>{{ 'deckbuilder.historic.source_url' | trans }}</span><input type="url" data-historic="source_url" value="{{ f.source_url ?? '' }}"></label>
                            <label class="rb-field rb-wide"><span>{{ 'deckbuilder.historic.archive_url' | trans }}</span><input type="url" data-historic="archive_url" value="{{ f.archive_url ?? '' }}"></label>
                            <label class="rb-field rb-wide"><span>{{ 'deckbuilder.historic.event' | trans }}</span><input type="text" data-historic="event" value="{{ f.event ?? '' }}" placeholder="{{ 'deckbuilder.historic.event_hint' | trans }}"></label>
                            <label class="rb-field"><span>{{ 'deckbuilder.historic.placing' | trans }}</span><input type="text" data-historic="placing" value="{{ f.placing ?? '' }}"></label>
                            <label class="rb-field"><span>{{ 'deckbuilder.historic.players' | trans }}</span><input type="text" data-historic="players" value="{{ f.players ?? '' }}"></label>
                            <label class="rb-field"><span>{{ 'deckbuilder.historic.date_posted' | trans }}</span><input type="text" data-historic="date_posted" value="{{ f.date_posted ?? '' }}" placeholder="{{ 'deckbuilder.historic.date_hint' | trans }}"></label>
                            <label class="rb-field"><span>{{ 'deckbuilder.historic.date_retrieved' | trans }}</span><input type="text" data-historic="date_retrieved" value="{{ f.date_retrieved ?? '' }}" placeholder="{{ 'deckbuilder.historic.date_hint' | trans }}"></label>
                            <label class="rb-field rb-wide"><span>{{ 'deckbuilder.historic.format_as_written' | trans }}</span><input type="text" data-historic="format_as_written" value="{{ f.format_as_written ?? '' }}"></label>
                            <label class="rb-field rb-wide"><span>{{ 'deckbuilder.historic.notes' | trans }}</span><textarea rows="3" data-historic="notes">{{ f.notes ?? '' }}</textarea></label>
                        </fieldset>
                    </details>
                </section>

                <section class="rb-deck" id="deck" aria-label="{{ 'deckbuilder.deck_label' | trans }}">
                    <div class="deck-loading"><i class="fas fa-spinner fa-spin fa-3x"></i></div>
                </section>
            </div>

            <!-- Right: filters and card pool, with the other tools as tabs -->
            <div class="col-md-6 rb-col-right">
                <ul class="nav nav-tabs rb-tabs" role="tablist">
                    <li role="presentation" class="active"><a href="#tab-pane-build" aria-controls="tab-pane-build" role="tab" data-toggle="tab">{{ 'decks.edit.tabs.build' | trans }}</a></li>
                    <li role="presentation"><a href="#tab-pane-infos" aria-controls="tab-pane-infos" role="tab" data-toggle="tab">{{ 'decks.edit.tabs.notes' | trans }}</a></li>
                    <li role="presentation"><a href="#tab-pane-draw" aria-controls="tab-pane-draw" role="tab" data-toggle="tab">{{ 'deckbuilder.tabs.draw' | trans }}</a></li>
                    <li role="presentation"><a href="#tab-pane-charts" aria-controls="tab-pane-charts" role="tab" data-toggle="tab">{{ 'decks.edit.tabs.charts' | trans }}</a></li>
                    <li role="presentation"><a href="#tab-pane-history" aria-controls="tab-pane-history" role="tab" data-toggle="tab" id="tab-header-history">{{ 'decks.edit.tabs.history' | trans }}</a></li>
                </ul>
                <div class="tab-content rb-tab-content">
                    <div role="tabpanel" class="tab-pane active rb-build-pane" id="tab-pane-build">
                        {% include 'Builder/tab-pane-build.html.twig' %}
                    </div>
                    <div role="tabpanel" class="tab-pane rb-scroll-pane" id="tab-pane-infos">
                        {% include 'Builder/tab-pane-infos.html.twig' %}
                    </div>
                    <div role="tabpanel" class="tab-pane rb-scroll-pane" id="tab-pane-draw">
                        {% include 'Builder/tab-pane-draw.html.twig' %}
                    </div>
                    <div role="tabpanel" class="tab-pane rb-scroll-pane" id="tab-pane-charts">
                        {% include 'Builder/tab-pane-charts.html.twig' %}
                    </div>
                    <div role="tabpanel" class="tab-pane rb-scroll-pane" id="tab-pane-history">
                        {% include 'Builder/tab-pane-history.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% include 'Modale/export.html.twig' %}
    {% include 'Modale/delete.html.twig' %}
    {% include 'Modale/odds.html.twig' %}
{% endblock %}
