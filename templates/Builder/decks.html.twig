{#
@file
    My Decks (Ketura, 2026-11-07): two tabs, the user's decks and their favourite decklists,
    sharing the decklists page's search and filters in a pane on the left (plus, for the decks,
    who can see them); the decks found in the middle; and on the right what can be done, to
    new decks and to the ones ticked. A row opens its deck in the deckbuilder.

    Available variables:
    - rows: this page of the decks found (App\Classes\DeckRow), total: how many
    - filters: the active filters (MyDecks::getFilters), tab among them: decks or favorites
    - formats: [{code, name, count}] the formats the decks target; format_names by code
    - cultures, cards: every culture; the cards being searched for
    - pager: PublishedDeckManager::getPager
    - nbmax, nbdecks, cannotcreate: the deck slots
    - tournaments
    Its blocks browse_tabs, browse_top, browse_fields, browse_results and browse_side are also
    sent alone, for the page to swap in as the filters or the tab change (ui.decklist_search.js).
#}
{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/ui.decklist_search.js') }}"></script>
    <script src="{{ asset('js/ui.decks.js') }}"></script>
{% endblock %}

{% block wrapper_class %}rb-fill{% endblock %}

{% block body %}
<div class="main white container rb-browse rb-my-decks">

    <div class="rb-browse-alerts">
        {% include 'alerts.html.twig' %}
        {% include 'banner-alerts.html.twig' %}
    </div>

    <div class="rb-browse-title rb-tabs" id="browse-tabs">{{ block('browse_tabs') }}</div>

    <form method="get" action="{{ path('decks_list') }}" class="rb-browse-pane" id="browse-form">
        <div class="rb-browse-top" id="browse-top">{{ block('browse_top') }}</div>
        <div class="rb-browse-fields" id="browse-fields">{{ block('browse_fields') }}</div>
    </form>

    <div class="rb-browse-splitter" id="browse-splitter" data-key="rb-my-decks-filters-width" role="separator" aria-orientation="vertical" title="{{ 'decklist.form.resize' | trans }}"></div>

    <aside class="rb-browse-side" id="browse-side">{{ block('browse_side') }}</aside>

    <div class="rb-browse-results" id="browse-results">{{ block('browse_results') }}</div>
</div>

{% include 'Modale/delete.html.twig' %}
{% include 'Modale/delete_list.html.twig' %}
{% include 'Modale/export.html.twig' %}
{% include 'Modale/odds.html.twig' %}
{% include 'Modale/tag_add.html.twig' %}
{% include 'Modale/tag_remove.html.twig' %}
{% include 'Modale/tag_clear.html.twig' %}
{% include 'Modale/diff.html.twig' %}
{% include 'Builder/download_list.html.twig' %}
{% endblock %}

{#
   The tabs (Ketura, 2026-11-07): the same filters, the user's decks or their favourites; the
   one not shown greyed out
#}
{% block browse_tabs %}
{% set tab = filters.tab ?? 'decks' %}
{% set query = app.request.query.all | filter((v, k) => k != 'page') %}
    <nav class="rb-tab-row" aria-label="{{ 'decks.browse.tabs.label' | trans }}">
        <a href="{{ list_path('decks_list', query | filter((v, k) => k != 'tab')) }}" class="rb-tab{{ tab == 'decks' ? ' is-active' }}"{% if tab == 'decks' %} aria-current="page"{% endif %} data-tab="decks">{{ 'decks.browse.tabs.decks' | trans }}</a>
        <a href="{{ list_path('decks_list', query | merge({tab: 'favorites'})) }}" class="rb-tab{{ tab == 'favorites' ? ' is-active' }}"{% if tab == 'favorites' %} aria-current="page"{% endif %} data-tab="favorites">{{ 'decks.browse.tabs.favorites' | trans }}</a>
    </nav>
    {# the most decks someone can keep, shown only as they near it (Ketura, 2026-11-07) #}
    {% if tab == 'decks' and nbdecks >= nbmax * 0.9 %}
        <span class="rb-slot-count{% if cannotcreate %} is-full{% endif %}" title="{{ 'decks.browse.slots_title' | trans }}">{{ 'decks.slotcount' | trans({'%max%': nbmax, '%current%': nbdecks}) }}</span>
    {% endif %}
{% endblock %}

{% block browse_top %}
{% set active = filters | filter((v, k) => k not in ['sort', 'limit', 'tab']) | length %}
            <button type="button" class="rb-filters-toggle" aria-expanded="false" aria-controls="browse-form">
                <span class="fas fa-sliders-h"></span> {{ 'decklist.browse.filters' | trans }}{% if active %} <span class="rb-more-count">{{ active }}</span>{% endif %}
            </button>
{% endblock %}

{% block browse_fields %}
{% include 'Decklist/browse-fields.html.twig' with {list_route: 'decks_list', my_decks: true} %}
{% endblock %}

{% block browse_results %}
{% import 'Decklist/macros.html.twig' as m %}
{% set f = filters %}
{% set query = app.request.query.all %}
{% set tab = f.tab ?? 'decks' %}
        <div class="rb-results-head">
            <span class="rb-results-count">{{ (tab == 'favorites' ? 'decks.browse.count_favorites' : 'decks.browse.count') | trans({'%count%': total, '%n%': total | number_format}) }}</span>
            <label class="rb-results-sort">
                <span>{{ 'decklist.browse.sort' | trans }}</span>
                <select name="sort" form="browse-form" class="form-control input-sm" data-autosubmit data-default="new">
                    {% for sort in ['new', 'old', 'name'] %}
                        <option value="{{ sort }}"{% if (f.sort ?? 'new') == sort %} selected{% endif %}>{{ ((tab == 'favorites' ? 'decklist.browse.sorts.' : 'decks.browse.sorts.') ~ sort) | trans }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>

        <div class="rb-results-scroll">
        {% if total %}
        {% set sorted = f.sort ?? 'new' %}
        <table class="rb-decks rb-my-decks-table rb-tab-{{ tab }}">
            <thead>
                <tr>
                    <th class="rb-col-pick"><input type="checkbox" class="toggle_all" title="{{ 'decks.selectAll' | trans }}" aria-label="{{ 'decks.selectAll' | trans }}"></th>
                    <th class="rb-col-thumb"></th>
                    <th class="rb-col-size" title="{{ 'decklist.browse.col.size_title' | trans }}">{{ 'decklist.browse.col.size' | trans }}</th>
                    <th class="rb-col-deck"><a href="{{ list_path('decks_list', query | merge({sort: 'name', page: null})) }}"{% if sorted == 'name' %} class="is-sorted"{% endif %}>{{ 'decklist.browse.col.deck' | trans }}</a></th>
                    <th class="rb-col-format">{{ 'decklist.browse.col.format' | trans }}</th>
                    {% if tab == 'decks' %}<th class="rb-col-visibility">{{ 'decks.browse.col.visibility' | trans }}</th>{% endif %}
                    <th class="rb-col-tags">{{ 'decklist.browse.col.tags' | trans }}</th>
                    <th class="rb-col-actions">{{ 'decks.browse.col.actions' | trans }}</th>
                </tr>
            </thead>
            <tbody id="decks">
            {% for row in rows %}
                {% set deck = row.deck %}
                {% set kind = row.kind %}
                {% if deck %}
                    {# a deck opens in the deckbuilder; Preview shows it (Ketura, 2026-11-07) #}
                    {% set url = path('deck_edit', {deck_uuid: deck.uuid}) %}
                {% else %}
                    {% set url = path('decklist_detail', {decklist_id: row.decklist.id, decklist_name: row.decklist.nameCanonical | e('url')}) %}
                {% endif %}
                <tr data-href="{{ url }}" class="rb-kind-{{ kind }} rb-row-{{ row.visibility }}{% if deck %} list-decks-deck{% endif %}" data-id="{{ deck ? deck.id : row.decklist.id }}"{% if deck %} data-uuid="{{ deck.uuid }}"{% endif %}>
                    <td class="rb-col-pick"><input type="checkbox" aria-label="{{ 'decks.browse.pick' | trans({'%name%': row.name}) }}"></td>
                    <td class="rb-col-thumb">{% include 'Decklist/thumbnail.html.twig' with {decklist: row.thumbnail} %}</td>
                    <td class="rb-col-size">
                        <span class="rb-size" title="{{ ('decklist.browse.kind_title.' ~ kind) | trans }}"><span class="rb-size-fp{% if not row.nbFreePeoples %} is-none{% endif %}">{{ row.nbFreePeoples ?: '–' }}</span><span class="rb-size-slash">/</span><span class="rb-size-sh{% if not row.nbShadow %} is-none{% endif %}">{{ row.nbShadow ?: '–' }}</span></span>
                    </td>
                    <td class="rb-col-deck">
                        <a href="{{ url }}" class="rb-deck-name deck-name">{{ row.name }}</a>
                        <span class="rb-deck-by">
                            {% if deck %}
                                {{ 'decks.browse.changed_on' | trans }} <time datetime="{{ row.date | date('Y-m-d') }}" data-absolute>{{ row.date | date('M j, Y') }}</time>
                                <span class="rb-deck-dot" aria-hidden="true">•</span> v{{ deck.version }}
                            {% else %}
                                {{ row.decklist.user.displayName }}
                                <span class="rb-deck-dot" aria-hidden="true">•</span> <time datetime="{{ row.date | date('Y-m-d') }}" data-absolute>{{ row.date | date('M j, Y') }}</time>
                            {% endif %}
                        </span>
                    </td>
                    <td class="rb-col-format">
                        <span class="rb-fmt">{{ format_names[row.format] ?? (row.format ?: '—') }}</span>
                        {% if deck %}<span class="rb-fmt-state">{% include 'Deck/completeness-label.html.twig' with {deck: deck} %}</span>{% endif %}
                    </td>
                    {% if tab == 'decks' %}
                        <td class="rb-col-visibility">
                            {% set icons = {private: 'fa-lock', hidden: 'fa-link', published: 'fa-globe-americas'} %}
                            <span class="rb-vis rb-vis-{{ row.visibility }}" title="{{ ('decks.browse.status.' ~ row.visibility) | trans }}"><span class="fas {{ icons[row.visibility] }} fa-fw" aria-hidden="true"></span> {{ ('decks.browse.show.' ~ row.visibility) | trans }}</span>
                            {% if row.published %}<a href="{{ path('decklist_detail', {decklist_id: row.published.id, decklist_name: row.published.nameCanonical | e('url')}) }}" class="rb-deck-published">{{ 'decks.browse.published_as' | trans({'%version%': row.published.version}) }}</a>{% endif %}
                        </td>
                    {% endif %}
                    <td class="rb-col-tags">
                        <span class="rb-row-tags tags">{% for tag in row.tags %}<button type="button" class="rb-tag-chip rb-tag-link{% if tag in (f.tags ?? []) %} is-on{% endif %}" data-tag="{{ tag }}" title="{{ 'decklist.browse.tag_search' | trans }}">{{ tag }}</button>{% endfor %}</span>
                    </td>
                    <td class="rb-col-actions">
                        {% if deck %}
                            <a href="{{ path('deck_view', {deck_uuid: deck.uuid}) }}" class="rb-icon-btn" data-tip="{{ 'decks.browse.do.preview' | trans }}" aria-label="{{ 'decks.browse.do.preview' | trans }}"><span class="fas fa-eye fa-fw"></span></a>
                            <a href="{{ path('deck_publish_form', {deck_uuid: deck.uuid}) }}" class="rb-icon-btn" data-tip="{{ 'decks.browse.do.publish' | trans }}" aria-label="{{ 'decks.browse.do.publish' | trans }}"><span class="fas fa-share fa-fw"></span></a>
                            <a href="{{ path('deck_clone', {deck_uuid: deck.uuid}) }}" class="rb-icon-btn" data-tip="{{ 'decks.browse.do.clone' | trans }}" aria-label="{{ 'decks.browse.do.clone' | trans }}"><span class="fas fa-clone fa-fw"></span></a>
                            <button type="button" class="rb-icon-btn rb-icon-danger btn-delete-deck" data-tip="{{ 'decks.browse.do.delete' | trans }}" aria-label="{{ 'decks.browse.do.delete' | trans }}"><span class="fas fa-trash-alt fa-fw"></span></button>
                        {% else %}
                            <a href="{{ path('deck_copy', {decklist_id: row.decklist.id}) }}" class="rb-icon-btn" data-tip="{{ 'decks.browse.do.copy' | trans }}" aria-label="{{ 'decks.browse.do.copy' | trans }}"><span class="fas fa-copy fa-fw"></span></a>
                            <button type="button" class="rb-icon-btn rb-icon-danger btn-unfavorite" data-tip="{{ 'decks.browse.do.unfavorite' | trans }}" aria-label="{{ 'decks.browse.do.unfavorite' | trans }}"><span class="fas fa-heart-broken fa-fw"></span></button>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
            <p class="rb-results-none">{{ (tab == 'favorites' ? 'decks.browse.none_favorites' : 'decks.browse.none') | trans }}</p>
        {% endif %}
        </div>
        <div class="rb-results-foot">
            {% include 'Decklist/pager.html.twig' with {pager_action: path('decks_list'), pager_always: true} %}
            <label class="rb-results-limit">
                <span>{{ 'decklist.browse.per_page' | trans }}</span>
                <select name="limit" form="browse-form" class="form-control input-sm" data-autosubmit data-default="{{ constant('App\\Services\\PublishedDeckManager::DEFAULT_LIMIT') }}">
                    {% for n in [10, 30, 50, 80, 100] %}
                        <option value="{{ n }}"{% if (f.limit ?? constant('App\\Services\\PublishedDeckManager::DEFAULT_LIMIT')) == n %} selected{% endif %}>{{ n }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>
{% endblock %}

{#
   What can be done (Ketura, 2026-11-07): new decks, on My Decks; and to the decks ticked,
   greyed out until some are
#}
{% block browse_side %}
{% set tab = filters.tab ?? 'decks' %}
    {% if tab == 'decks' %}
        <section class="rb-side-section">
            <a href="{{ path('deck_buildform') }}" class="btn btn-default rb-side-btn{% if cannotcreate %} disabled{% endif %}"><span class="fas fa-plus fa-fw"></span> {{ 'decks.form.new' | trans }}</a>
            {# pasted text for now; a file too, on the same page, later (Ketura, 2026-11-07) #}
            <a href="{{ path('deck_import') }}" class="btn btn-default rb-side-btn{% if cannotcreate %} disabled{% endif %}" id="btn-import"><span class="fas fa-file-import fa-fw"></span> {{ 'decks.browse.side.import' | trans }}</a>
        </section>
    {% endif %}
    <section class="rb-side-section rb-selection is-off" id="btn-group-selection" data-token="{{ csrf_token('my_favorites') }}" data-unfavorite="{{ path('decklists_unfavorite') }}">
        <h2 class="rb-side-title">{{ 'decks.browse.side.selection' | trans }} <span class="rb-selected-count"></span></h2>
        <p class="rb-side-hint">{{ 'decks.browse.side.selection_none' | trans }}</p>
        {% if tab == 'decks' %}
            <button type="button" class="btn btn-default rb-side-btn" id="btn-download-selected" disabled><span class="fas fa-file-download fa-fw"></span> {{ 'decks.browse.side.download' | trans }}</button>
            <button type="button" class="btn btn-default rb-side-btn" id="btn-compare" data-needs="2" disabled><span class="fas fa-exchange-alt fa-fw"></span> {{ 'decks.browse.side.compare' | trans }}</button>
            <button type="button" class="btn btn-default rb-side-btn" id="btn-tag-add" disabled><span class="fas fa-tag fa-fw"></span> {{ 'decks.browse.side.tag_add' | trans }}</button>
            <button type="button" class="btn btn-default rb-side-btn" id="btn-tag-remove-one" disabled><span class="fas fa-eraser fa-fw"></span> {{ 'decks.browse.side.tag_remove' | trans }}</button>
            <button type="button" class="btn btn-default rb-side-btn" id="btn-tag-remove-all" disabled><span class="fas fa-tags fa-fw"></span> {{ 'decks.browse.side.tag_clear' | trans }}</button>
            <button type="button" class="btn btn-default rb-side-btn rb-side-danger" id="btn-delete-selected" disabled><span class="fas fa-trash-alt fa-fw"></span> {{ 'decks.browse.side.delete' | trans }}</button>
        {% else %}
            <button type="button" class="btn btn-default rb-side-btn rb-side-danger" id="btn-unfavorite-selected" disabled><span class="fas fa-heart-broken fa-fw"></span> {{ 'decks.browse.side.unfavorite' | trans }}</button>
        {% endif %}
    </section>
{% endblock %}
