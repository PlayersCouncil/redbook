{#
@file
    The decklists page (Ketura, 2026-11-05): the search and filters, and the decks they find.

    Available variables:
    - decklists, total: this page of decks and how many match
    - filters: the active filters (PublishedDeckManager::getFilters)
    - formats: [{code, name, count}] the formats decks target, most used first
    - format_names: format names by code
    - cultures: every culture
    - cards: the cards being searched for
    - pager: PublishedDeckManager::getPager
    Its blocks browse_top, browse_fields and browse_results are also sent alone, for the
    page to swap in as the filters change without loading the page again.
#}
{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/ui.decklist_search.js') }}"></script>
    <script src="{{ asset('js/ui.decklists_actions.js') }}"></script>
{% endblock %}

{# a pane of filters beside the results, which alone scroll (Ketura, 2026-11-06); a narrow
   window stacks them and scrolls as a page #}
{% block wrapper_class %}rb-fill{% endblock %}

{% block body %}
<div class="main white container rb-browse">

    {% include 'alerts.html.twig' %}

    {# the title (Ketura, 2026-11-09); with My Favorites beside it for someone logged in
       (2026-11-11: moved here from My Decks), the decklists they favourited, searched the same way #}
    {% if app.user %}
        {% set fav = filters.favorites ?? false %}
        {% set query = app.request.query.all | filter((v, k) => k not in ['page', 'favorites']) %}
        <div class="rb-browse-title"><div class="rb-tabs">
            <nav class="rb-tab-row" aria-label="{{ 'decklist.list.tabs' | trans }}">
                <a href="{{ path('decklists_list', query) }}" class="rb-tab{{ fav ? '' : ' is-active' }}"{% if not fav %} aria-current="page"{% endif %} data-list-tab="all">{{ 'decklist.list.title' | trans }}</a>
                <a href="{{ path('decklists_list', query | merge({favorites: 1})) }}" class="rb-tab{{ fav ? ' is-active' }}"{% if fav %} aria-current="page"{% endif %} data-list-tab="favorites">{{ 'decks.browse.tabs.favorites' | trans }}</a>
            </nav>
        </div></div>
    {% else %}
        <div class="rb-browse-title"><div class="rb-tabs"><h1 class="rb-tab-solo">{{ 'decklist.list.title' | trans }}</h1></div></div>
    {% endif %}

    <form method="get" action="{{ path('decklists_list') }}" class="rb-browse-pane" id="browse-form">
        <div class="rb-browse-top" id="browse-top">{{ block('browse_top') }}</div>
        <div class="rb-browse-fields" id="browse-fields">{{ block('browse_fields') }}</div>
    </form>

    {# the filters resize against the results (Ketura, 2026-11-07) #}
    <div class="rb-browse-splitter" id="browse-splitter" data-key="rb-decklists-filters-width" role="separator" aria-orientation="vertical" title="{{ 'decklist.form.resize' | trans }}"></div>

    <div class="rb-browse-results" id="browse-results">{{ block('browse_results') }}</div>
</div>
{% endblock %}

{# The parts the page replaces as the filters change (SocialController::listAction) #}
{% block browse_top %}
{% set f = filters %}
            {% set active = f | filter((v, k) => k not in ['sort', 'limit']) | length %}
            <button type="button" class="rb-filters-toggle" aria-expanded="false" aria-controls="browse-form">
                <span class="fas fa-sliders-h"></span> {{ 'decklist.browse.filters' | trans }}{% if active %} <span class="rb-more-count">{{ active }}</span>{% endif %}
            </button>
{% endblock %}

{% block browse_fields %}
{% include 'Decklist/browse-fields.html.twig' with {list_route: 'decklists_list'} %}
{% endblock %}

{% block browse_results %}
{% import 'Tags/tags.html.twig' as tags %}
{% import 'Decklist/macros.html.twig' as m %}
{% set f = filters %}
{% set query = app.request.query.all %}
        <div class="rb-results-head">
            <span class="rb-results-count">{{ 'decklist.browse.count' | trans({'%count%': total, '%n%': total | number_format}) }}</span>
            <label class="rb-results-sort">
                <span>{{ 'decklist.browse.sort' | trans }}</span>
                <select name="sort" form="browse-form" class="form-control input-sm" data-autosubmit data-default="new">
                    {% for sort in ['new', 'old', 'rated', 'name', 'comments'] %}
                        <option value="{{ sort }}"{% if (f.sort ?? 'new') == sort %} selected{% endif %}>{{ ('decklist.browse.sorts.' ~ sort) | trans }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>

        {#
           What can be done to the decklists ticked (Ketura, 2026-11-11): into or out of the
           favourites, into a library. It shows once some are; the tick boxes, for someone
           logged in (ui.decklists_actions.js: the list is the same for everyone).
        #}
        <div class="rb-pick-bar" id="decklist-selection" hidden>
            <span class="rb-pick-count" aria-live="polite"></span>
            <button type="button" class="rb-btn rb-btn-small" data-pick-act="favorite"><svg class="rb-ri" aria-hidden="true"><use href="#ri-fav"/></svg> {{ 'decklist.browse.do.favorite' | trans }}</button>
            <button type="button" class="rb-btn rb-btn-small" data-pick-act="unfavorite"><span class="far fa-bookmark" aria-hidden="true"></span> {{ 'decks.browse.do.unfavorite' | trans }}</button>
            <button type="button" class="rb-btn rb-btn-small" data-pick-act="library"><span class="fas fa-folder-plus" aria-hidden="true"></span> {{ 'library.add.button' | trans }}</button>
            <button type="button" class="rb-btn rb-btn-small rb-btn-ghost" data-pick-act="clear">{{ 'decklist.browse.do.clear' | trans }}</button>
        </div>

        <div class="rb-results-scroll">
        {% if total %}
        {% set sorted = f.sort ?? 'new' %}
        <table class="rb-decks" id="decklists-table"{% if f.favorites ?? false %} data-favorites-tab{% endif %}>
            <thead>
                <tr>
                    <th class="rb-col-pick"><input type="checkbox" class="rb-pick-all" title="{{ 'decks.selectAll' | trans }}" aria-label="{{ 'decks.selectAll' | trans }}"></th>
                    <th class="rb-col-thumb"></th>
                    <th class="rb-col-score"><a href="{{ list_path('decklists_list', query | merge({sort: 'rated', page: null})) }}"{% if sorted == 'rated' %} class="is-sorted"{% endif %}>{{ 'decklist.browse.col.score' | trans }}</a></th>
                    <th class="rb-col-size" title="{{ 'decklist.browse.col.size_title' | trans }}">{{ 'decklist.browse.col.size' | trans }}</th>
                    <th class="rb-col-deck"><a href="{{ list_path('decklists_list', query | merge({sort: 'name', page: null})) }}"{% if sorted == 'name' %} class="is-sorted"{% endif %}>{{ 'decklist.browse.col.deck' | trans }}</a></th>
                    <th class="rb-col-format">{{ 'decklist.browse.col.format' | trans }}</th>
                    <th class="rb-col-tags">{{ 'decklist.browse.col.tags' | trans }}</th>
                    <th class="rb-col-actions">{{ 'decks.browse.col.actions' | trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for decklist in decklists %}
                {% set url = path('decklist_detail', {decklist_id: decklist.id, decklist_name: decklist.nameCanonical | e('url')}) %}
                {% set kind = decklist.kind %}
                {% set score = decklist.score %}
                {# fire instead of the thumbs up once fires are a tenth of the votes (Ketura, 2026-11-05);
                   a crown once crowns are (2026-11-11) #}
                {% set fiery = decklist.nbVotes > 0 and decklist.nbFires * 10 >= decklist.nbVotes %}
                {% set crowned = decklist.nbVotes > 0 and decklist.nbCrowns * 10 >= decklist.nbVotes %}
                {% set tags = decklist.tags ? decklist.tags | split(' ') | filter(t => t) : [] %}
                <tr data-href="{{ url }}" data-id="{{ decklist.id }}" class="rb-kind-{{ kind }}">
                    <td class="rb-col-pick"><input type="checkbox" aria-label="{{ 'decks.browse.pick' | trans({'%name%': decklist.name}) }}"></td>
                    <td class="rb-col-thumb">{% include 'Decklist/thumbnail.html.twig' %}</td>
                    <td class="rb-col-score">
                        <span class="rb-score{% if not score %} is-zero{% endif %}{% if fiery %} is-fiery{% endif %}{% if crowned %} is-crowned{% endif %}" title="{{ 'decklist.browse.score_title' | trans({'%likes%': decklist.nbVotes, '%fires%': decklist.nbFires, '%crowns%': decklist.nbCrowns}) }}"><svg class="rb-ri" aria-hidden="true"><use href="#ri-{{ crowned ? 'crown' : (fiery ? 'fire' : 'cheers') }}"/></svg> {{ score }}</span>
                        {% if decklist.nbComments %}<span class="rb-comments" title="{{ 'decklist.browse.comments_title' | trans({'%count%': decklist.nbComments}) }}"><span class="fas fa-comment"></span> {{ decklist.nbComments }}</span>{% endif %}
                    </td>
                    <td class="rb-col-size">
                        <span class="rb-size" title="{{ ('decklist.browse.kind_title.' ~ kind) | trans }}"><span class="rb-size-fp{% if not decklist.nbFreePeoples %} is-none{% endif %}">{{ decklist.nbFreePeoples ?: '–' }}</span><span class="rb-size-slash">/</span><span class="rb-size-sh{% if not decklist.nbShadow %} is-none{% endif %}">{{ decklist.nbShadow ?: '–' }}</span></span>
                    </td>
                    <td class="rb-col-deck">
                        <a href="{{ url }}" class="rb-deck-name">{{ decklist.name }}</a>
                        <span class="rb-deck-by">
                            {{ decklist.user.displayName }}{% if decklist.user.historic %} {{ tags.account(decklist.user, 'decklist.browse.archive') }}{% endif %}
                            <span class="rb-deck-dot" aria-hidden="true">•</span> <time datetime="{{ decklist.dateCreation | date('Y-m-d') }}" data-absolute>{{ decklist.dateCreation | date('M j, Y') }}</time>
                        </span>
                    </td>
                    <td class="rb-col-format">
                        {% if decklist.targetFormat %}{{ tags.format(format_names[decklist.targetFormat] ?? decklist.targetFormat, false) }}{% else %}<span class="rb-fmt">—</span>{% endif %}
                    </td>
                    <td class="rb-col-tags">
                        {% if tags %}<span class="rb-row-tags">{% for tag in tags %}<button type="button" class="rb-tag-chip rb-tag-link{% if tag in (f.tags ?? []) %} is-on{% endif %}" data-tag="{{ tag }}" title="{{ 'decklist.browse.tag_search' | trans }}">{{ tag }}</button>{% endfor %}</span>{% endif %}
                    </td>
                    {# Favourite, Clone, Download and Add to Library (Ketura, 2026-11-08 for Add to Library;
                       the rest 2026-11-11). Whose favourite it is comes from the page's script, so the
                       page stays cacheable; logged out, Favourite and Clone lead to the login page #}
                    <td class="rb-col-actions">
                        <button type="button" class="rb-icon-btn rb-fav-btn" data-favorite="{{ decklist.id }}" aria-pressed="false" data-tip="{{ 'decklist.view.social.favorite' | trans }}" aria-label="{{ 'decklist.view.social.favorite' | trans }}"><svg class="rb-ri" aria-hidden="true"><use href="#ri-fav"/></svg></button>
                        <a class="rb-icon-btn" href="{{ path('deck_copy', {decklist_id: decklist.id}) }}" data-tip="{{ 'decklist.browse.do.clone' | trans }}" aria-label="{{ 'decklist.browse.do.clone' | trans }}"><span class="fas fa-code-branch fa-fw"></span></a>
                        <a class="rb-icon-btn" href="{{ path('decklist_download', {decklist_id: decklist.id}) }}" data-tip="{{ 'decklist.browse.do.download' | trans }}" aria-label="{{ 'decklist.browse.do.download' | trans }}"><span class="fas fa-file-download fa-fw"></span></a>
                        <button type="button" class="rb-icon-btn" data-library-add="{{ decklist.id }}" data-tip="{{ 'library.add.button' | trans }}" aria-label="{{ 'library.add.button' | trans }}" aria-haspopup="dialog"><span class="fas fa-folder-plus fa-fw"></span></button>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% else %}
            <p class="rb-results-none">{{ 'decklist.browse.none' | trans }}</p>
        {% endif %}
        </div>
        <div class="rb-results-foot">
            {% include 'Decklist/pager.html.twig' %}
            <label class="rb-results-limit">
                <span>{{ 'decklist.browse.per_page' | trans }}</span>
                <select name="limit" form="browse-form" class="form-control input-sm" data-autosubmit data-default="{{ constant('App\\Services\\PublishedDeckManager::DEFAULT_LIMIT') }}">
                    {% for n in [10, 30, 50, 80, 100] %}
                        <option value="{{ n }}"{% if (f.limit ?? constant('App\\Services\\PublishedDeckManager::DEFAULT_LIMIT')) == n %} selected{% endif %}>{{ n }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>
{% endblock %}
