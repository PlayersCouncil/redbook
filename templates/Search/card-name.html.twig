{% if card.is_unique == true %}
    <span class="card-unique" title="{{ 'card.info.unique' | trans }}">&bull;</span>
{% endif %}
<span class="card-name{% if card.available == false %} card-preview{% endif %}">{{ card.name }}{% if card.subtitle %}, <span class="card-subtitle">{{ card.subtitle }}</span>{% endif %}</span>
