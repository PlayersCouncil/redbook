{% extends 'Search/display.html.twig' %}

{% block main %}

    <table class="rwd-table table table-striped table-condensed">
        <thead>
        <tr>
            <th>{{ 'card.info.name' | trans }}</th>
            <th>{{ 'card.info.culture' | trans }}</th>
            <th>{{ 'card.info.type' | trans }}</th>
            <th>{{ 'card.info.twilight' | trans }}</th>
            <th>{{ 'card.info.strength' | trans }}</th>
            <th>{{ 'card.info.vitality' | trans }}</th>
            <th>{{ 'card.info.subtypes' | trans }}</th>
            <th>{{ 'card.info.set' | trans }}</th>
        </tr>
        </thead>
        {% for i in 0..cards|length-1 %}
            <tr class="{% if i%2==0 %}even{% else %}odd{% endif %}">
                {% set card = cards[i] %}
                <td data-th="{{ 'card.info.name' | trans }}">
                    <a href="{{ card.url }}" class="card-tip{% if card.available == false %} card-preview{% endif %}"
                       data-code="{{ card.code }}">{% if card.is_unique %}&bull;{% endif %}{{ card.label }}</a>
                </td>
                <td data-th="{{ 'card.info.culture' | trans }}">{{ card.culture_name ?? '' }}</td>
                <td data-th="{{ 'card.info.type' | trans }}">{{ card.type_name }}</td>
                <td data-th="{{ 'card.info.twilight' | trans }}">{{ card.twilight }}</td>
                <td data-th="{{ 'card.info.strength' | trans }}">{{ card.strength ?? card.strength_mod }}</td>
                <td data-th="{{ 'card.info.vitality' | trans }}">{{ card.vitality ?? card.vitality_mod }}</td>
                <td data-th="{{ 'card.info.subtypes' | trans }}">{{ card.subtypes }}</td>
                <td data-th="{{ 'card.info.set' | trans }}">{{ card.pack_name }} {{ card.position }}</td>
            </tr>
        {% endfor %}
    </table>

{% endblock %}
