{# A published deck's thumbnail (Ketura, 2026-11-05), the size of a half-thumb in the deckbuilder:
   its chosen card's picture, or else a raised tile of its cultures' card art, enlarged past the
   edges and cropped: a whole deck's main Free Peoples culture top left and main Shadow culture
   bottom right (Gollum can be either), divided along the diagonal; a fragment's main culture
   filling the tile (PublishedDeck::pickThumbnailCultures). Each
   culture's framing is set in style.css (.rb-thumb-c-<code>).
   Variables: decklist; thumb_card to show another card instead, or false for the cultures #}
{% set card = thumb_card ?? decklist.thumbnailCard %}
{% if card and card.imageUrl %}
    {# just the card's picture (Ketura, 2026-11-07), framed by its template: characters, sites,
       and everything else (the ring included), unless the author framed it themselves #}
    {% set crop = decklist.thumbnailCropFor(card) %}
    <span class="rb-thumb rb-thumb-card rb-thumb-tpl-{{ card.thumbnailTemplate }}" data-hover-code="{{ card.code }}"><img src="{{ card.imageUrl }}" alt="{{ card.fullName }}" loading="lazy"{% if crop %} style="width: {{ crop.w }}%; left: {{ crop.l }}%; top: {{ crop.t }}%"{% endif %}></span>
{% else %}
    {% set parts = decklist.thumbnailCultures %}
    <span class="rb-thumb rb-thumb-cultures" role="img" aria-label="{{ parts | map(p => p.name) | join(' / ') }}">
        {% for part in parts %}
            {%- set code = part.code -%}
            <span class="rb-thumb-part rb-thumb-{{ part.corner }} rb-thumb-side-{{ part.side ?? 'free_peoples' }} rb-thumb-c-{{ code | replace({'_': '-'}) }}" style="--art: url({{ asset('images/cultures/art/' ~ code ~ '.webp') }})"><span class="rb-thumb-icon"></span></span>
        {% endfor %}
    </span>
{% endif %}
