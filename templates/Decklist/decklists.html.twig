{#
@file
    The decklists page (Ketura, 2026-11-05): search and filters on top, the decks below. The
    presets along the top are the old tabs, now links that set the filters.

    Available variables:
    - decklists, total: this page of decks and how many match
    - filters: the active filters (PublishedDeckManager::getFilters)
    - presets, preset: the presets' filters by name, and the one the filters match if any
    - formats: [{code, name, count}] the formats decks target, most used first
    - format_names: format names by code
    - cultures: every culture
    - cards: the cards being searched for
    - pager: PublishedDeckManager::getPager
    Its blocks browse_top, browse_fields and browse_results are also sent alone, for the
    page to swap in as the filters change without loading the page again.
#}
{% extends 'base.html.twig' %}

{% macro culture_icon(culture, count) %}
    {%- set file = culture.code == 'uruk_hai' ? 'uruk' : culture.code -%}
    <span class="culture-icon" role="img" aria-label="{{ culture.name }}" title="{{ culture.name }}{% if count is not null %} · {{ count }}{% endif %}"
          style="--icon:url({{ asset('images/cultures/' ~ file ~ '.svg') }}); color: var(--rb-culture-{{ culture.code | replace({'_': '-'}) }}, currentColor)"></span>
{%- endmacro %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/ui.decklist_search.js') }}"></script>
{% endblock %}

{# a pane of filters beside the results, which alone scroll (Ketura, 2026-11-06); a narrow
   window stacks them and scrolls as a page #}
{% block wrapper_class %}rb-fill{% endblock %}

{% block body %}
<div class="main white container rb-browse">

    {% include 'alerts.html.twig' %}

    <form method="get" action="{{ path('decklists_list') }}" class="rb-browse-pane" id="browse-form">
        <div class="rb-browse-top" id="browse-top">{{ block('browse_top') }}</div>
        <div class="rb-browse-fields" id="browse-fields">{{ block('browse_fields') }}</div>
    </form>

    <div class="rb-browse-results" id="browse-results">{{ block('browse_results') }}</div>
</div>
{% endblock %}

{# The parts the page replaces as the filters change (SocialController::listAction) #}
{% block browse_top %}
{% set f = filters %}
            <h1 class="rb-browse-title">{{ 'decklist.list.title' | trans }}</h1>
            <nav class="rb-presets" aria-label="{{ 'decklist.browse.presets' | trans }}">
                {% for key, params in presets %}
                    <a href="{{ list_path('decklists_list', f.limit is defined ? params | merge({limit: f.limit}) : params) }}" class="rb-preset{% if preset == key %} is-active{% endif %}">{{ ('decklist.browse.preset.' ~ key) | trans }}</a>
                {% endfor %}
            </nav>
            {% set active = f | filter((v, k) => k not in ['sort', 'limit']) | length %}
            <button type="button" class="rb-filters-toggle" aria-expanded="false" aria-controls="browse-form">
                <span class="fas fa-sliders-h"></span> {{ 'decklist.browse.filters' | trans }}{% if active %} <span class="rb-more-count">{{ active }}</span>{% endif %}
            </button>
{% endblock %}

{% block browse_fields %}
{% import _self as m %}
{% set f = filters %}
{% set active = f | filter((v, k) => k not in ['sort', 'limit']) | length %}
        <div class="rb-browse-search">
            <label class="rb-field">
                <span>{{ 'decklist.browse.name' | trans }}</span>
                <input type="search" name="name" class="form-control input-sm" value="{{ f.name ?? '' }}">
            </label>
            <label class="rb-field">
                <span>{{ 'decklist.browse.author' | trans }}</span>
                <input type="search" name="author" class="form-control input-sm" value="{{ f.author ?? '' }}">
            </label>
            <label class="rb-field">
                <span>{{ 'decklist.browse.event' | trans }}</span>
                <input type="search" name="event" class="form-control input-sm" value="{{ f.event ?? '' }}">
            </label>
            <div class="rb-field rb-field-cards">
                <label for="browse-card">{{ 'decklist.browse.cards' | trans }}</label>
                <div class="rb-card-picks form-control input-sm" id="browse-cards">
                    {% for card in cards %}
                        <span class="rb-card-pick"><input type="hidden" name="cards[]" value="{{ card.code }}">{{ card.fullName }}<button type="button" aria-label="{{ 'decklist.browse.remove' | trans }}">&times;</button></span>
                    {% endfor %}
                    <input type="text" id="browse-card" autocomplete="off" placeholder="{{ 'decklist.browse.cards_hint' | trans }}">
                </div>
            </div>
            {# tags: typed, or clicked on a deck's row (Ketura, 2026-11-06); a deck has them all #}
            <div class="rb-field rb-field-tags">
                <label for="browse-tag">{{ 'decklist.browse.tags' | trans }}</label>
                <div class="rb-card-picks form-control input-sm" id="browse-tags">
                    {% for tag in f.tags ?? [] %}
                        <span class="rb-card-pick rb-tag-pick"><input type="hidden" name="tags[]" value="{{ tag }}">{{ tag }}<button type="button" aria-label="{{ 'decklist.browse.remove' | trans }}">&times;</button></span>
                    {% endfor %}
                    <input type="text" id="browse-tag" autocomplete="off" placeholder="{{ 'decklist.browse.tags_hint' | trans }}">
                </div>
            </div>
        </div>

        <div class="rb-browse-filters">
            <label class="rb-field rb-field-format">
                <span>{{ 'decklist.browse.format' | trans }}</span>
                <select name="format" class="form-control input-sm" data-autosubmit>
                    <option value="">{{ 'decklist.browse.any_format' | trans }}</option>
                    {% for format in formats %}
                        <option value="{{ format.code }}"{% if (f.format ?? '') == format.code %} selected{% endif %}>{{ format.name }} ({{ format.count }})</option>
                    {% endfor %}
                </select>
            </label>
            <div class="rb-field rb-field-years">
                <span>{{ 'decklist.browse.played' | trans }}</span>
                <div class="rb-years">
                    <input type="number" name="from" class="form-control input-sm" min="2001" max="2100" placeholder="{{ 'decklist.browse.from' | trans }}" value="{{ f.from ?? '' }}" aria-label="{{ 'decklist.browse.from' | trans }}">
                    <span>–</span>
                    <input type="number" name="to" class="form-control input-sm" min="2001" max="2100" placeholder="{{ 'decklist.browse.to' | trans }}" value="{{ f.to ?? '' }}" aria-label="{{ 'decklist.browse.to' | trans }}">
                </div>
            </div>
            <div class="rb-field">
                <span>{{ 'decklist.browse.show' | trans }}</span>
                <div class="rb-toggles" data-kinds>
                    {% for kind in ['whole', 'free_peoples', 'shadow'] %}
                        <label class="rb-toggle rb-toggle-{{ kind }}" title="{{ ('decklist.browse.kind_title.' ~ kind) | trans }}">
                            <input type="checkbox" name="kind[]" value="{{ kind }}" data-autosubmit{% if f.kind is not defined or kind in f.kind %} checked{% endif %}>
                            <span>{{ ('decklist.browse.kind.' ~ kind) | trans }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>
            <div class="rb-field">
                <span>{{ 'decklist.browse.only' | trans }}</span>
                <div class="rb-toggles">
                    <label class="rb-toggle" title="{{ 'decklist.browse.played_title' | trans }}">
                        <input type="checkbox" name="played" value="1" data-autosubmit{% if f.played ?? false %} checked{% endif %}>
                        <span><span class="fas fa-trophy"></span> {{ 'decklist.browse.played_only' | trans }}</span>
                    </label>
                    <label class="rb-toggle" title="{{ 'decklist.browse.legal_title' | trans }}">
                        <input type="checkbox" name="legal" value="1" data-autosubmit{% if f.legal ?? false %} checked{% endif %}>
                        <span><span class="fas fa-check"></span> {{ 'decklist.browse.legal' | trans }}</span>
                    </label>
                    {% if app.user %}
                        <label class="rb-toggle">
                            <input type="checkbox" name="mine" value="1" data-autosubmit{% if f.mine ?? false %} checked{% endif %}>
                            <span>{{ 'decklist.browse.preset.mine' | trans }}</span>
                        </label>
                        <label class="rb-toggle">
                            <input type="checkbox" name="favorites" value="1" data-autosubmit{% if f.favorites ?? false %} checked{% endif %}>
                            <span>{{ 'decklist.browse.preset.favorites' | trans }}</span>
                        </label>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="rb-browse-cultures">
            <span class="rb-browse-label">{{ 'decklist.browse.cultures' | trans }}</span>
            {% for side in ['free_peoples', 'shadow'] %}
                {% if not loop.first %}<span class="rb-culture-sep"></span>{% endif %}
                {% for culture in cultures | filter(c => c.side == side) %}
                    <label class="rb-culture-pick" title="{{ culture.name }}">
                        <input type="checkbox" name="culture[]" value="{{ culture.code }}" data-autosubmit{% if culture.code in (f.culture ?? []) %} checked{% endif %}>
                        <span>{{ m.culture_icon(culture, null) }}</span>
                    </label>
                {% endfor %}
            {% endfor %}
            <span class="rb-browse-actions">
                {% if active %}<a href="{{ list_path('decklists_list', f | filter((v, k) => k in ['sort', 'limit'])) }}" class="rb-browse-clear">{{ 'decklist.browse.clear' | trans }}</a>{% endif %}
                <button type="submit" class="btn btn-primary btn-sm"><span class="fas fa-search"></span> {{ 'decklist.browse.search' | trans }}</button>
            </span>
        </div>
{% endblock %}

{% block browse_results %}
{% import _self as m %}
{% set f = filters %}
{% set query = app.request.query.all %}
        <div class="rb-results-head">
            <span class="rb-results-count">{{ 'decklist.browse.count' | trans({'%count%': total, '%n%': total | number_format}) }}</span>
            <label class="rb-results-sort">
                <span>{{ 'decklist.browse.sort' | trans }}</span>
                <select name="sort" form="browse-form" class="form-control input-sm" data-autosubmit>
                    {% for sort in ['new', 'old', 'rated', 'name', 'comments'] %}
                        <option value="{{ sort }}"{% if (f.sort ?? 'new') == sort %} selected{% endif %}>{{ ('decklist.browse.sorts.' ~ sort) | trans }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>

        <div class="rb-results-scroll">
        {% if total %}
        {% set sorted = f.sort ?? 'new' %}
        <table class="rb-decks">
            <thead>
                <tr>
                    <th class="rb-col-thumb"></th>
                    <th class="rb-col-score"><a href="{{ list_path('decklists_list', query | merge({sort: 'rated', page: null})) }}"{% if sorted == 'rated' %} class="is-sorted"{% endif %}>{{ 'decklist.browse.col.score' | trans }}</a></th>
                    <th class="rb-col-size" title="{{ 'decklist.browse.col.size_title' | trans }}">{{ 'decklist.browse.col.size' | trans }}</th>
                    <th class="rb-col-deck"><a href="{{ list_path('decklists_list', query | merge({sort: 'name', page: null})) }}"{% if sorted == 'name' %} class="is-sorted"{% endif %}>{{ 'decklist.browse.col.deck' | trans }}</a></th>
                    <th class="rb-col-format">{{ 'decklist.browse.col.format' | trans }}</th>
                    <th class="rb-col-cultures">{{ 'decklist.browse.cultures' | trans }}</th>
                    <th class="rb-col-tags">{{ 'decklist.browse.col.tags' | trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for decklist in decklists %}
                {% set url = path('decklist_detail', {decklist_id: decklist.id, decklist_name: decklist.nameCanonical | e('url')}) %}
                {% set kind = decklist.kind %}
                {% set score = decklist.nbVotes + 2 * decklist.nbFires %}
                {# fire instead of the thumbs up once fires are a tenth of the votes (Ketura, 2026-11-05) #}
                {% set fiery = decklist.nbVotes > 0 and decklist.nbFires * 10 >= decklist.nbVotes %}
                {% set tags = decklist.parent and decklist.parent.tags ? decklist.parent.tags | split(' ') | filter(t => t) : [] %}
                <tr data-href="{{ url }}" class="rb-kind-{{ kind }}">
                    <td class="rb-col-thumb">{% include 'Decklist/thumbnail.html.twig' %}</td>
                    <td class="rb-col-score">
                        <span class="rb-score{% if not score %} is-zero{% endif %}{% if fiery %} is-fiery{% endif %}" title="{{ 'decklist.browse.score_title' | trans({'%likes%': decklist.nbVotes, '%fires%': decklist.nbFires}) }}"><span class="fas {{ fiery ? 'fa-fire' : 'fa-thumbs-up' }}"></span> {{ score }}</span>
                        {% if decklist.nbComments %}<span class="rb-comments" title="{{ 'decklist.browse.comments_title' | trans({'%count%': decklist.nbComments}) }}"><span class="fas fa-comment"></span> {{ decklist.nbComments }}</span>{% endif %}
                    </td>
                    <td class="rb-col-size">
                        <span class="rb-size" title="{{ ('decklist.browse.kind_title.' ~ kind) | trans }}"><span class="rb-size-fp{% if not decklist.nbFreePeoples %} is-none{% endif %}">{{ decklist.nbFreePeoples ?: '–' }}</span><span class="rb-size-slash">/</span><span class="rb-size-sh{% if not decklist.nbShadow %} is-none{% endif %}">{{ decklist.nbShadow ?: '–' }}</span></span>
                    </td>
                    <td class="rb-col-deck">
                        <a href="{{ url }}" class="rb-deck-name">{{ decklist.name }}</a>
                        <span class="rb-deck-by">
                            {{ decklist.user.displayName }}{% if decklist.user.historic %} <span class="rb-archive-mark" title="{{ 'user.historic.badge_title' | trans }}">{{ 'decklist.browse.archive' | trans }}</span>{% endif %}
                            <span class="rb-deck-dot" aria-hidden="true">•</span> <time datetime="{{ decklist.dateCreation | date('Y-m-d') }}" data-absolute>{{ decklist.dateCreation | date('M j, Y') }}</time>
                        </span>
                    </td>
                    <td class="rb-col-format">
                        <span class="rb-fmt">{{ format_names[decklist.targetFormat] ?? (decklist.targetFormat ?: '—') }}</span>
                    </td>
                    <td class="rb-col-cultures">
                        {% set rows = decklist.cultures | filter(r => r.culture.side) | sort((a, b) => b.count <=> a.count) %}
                        {% for side in ['free_peoples', 'shadow'] %}
                            <span class="rb-row-cultures rb-row-cultures-{{ side }}">{% for row in rows | filter(r => r.culture.side == side) %}{{ m.culture_icon(row.culture, row.count) }}{% endfor %}</span>
                        {% endfor %}
                    </td>
                    <td class="rb-col-tags">
                        {% if tags %}<span class="rb-row-tags">{% for tag in tags %}<button type="button" class="rb-tag-chip rb-tag-link{% if tag in (f.tags ?? []) %} is-on{% endif %}" data-tag="{{ tag }}" title="{{ 'decklist.browse.tag_search' | trans }}">{{ tag }}</button>{% endfor %}</span>{% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% else %}
            <p class="rb-results-none">{{ 'decklist.browse.none' | trans }}</p>
        {% endif %}
        </div>
        <div class="rb-results-foot">
            {% include 'Decklist/pager.html.twig' %}
            <label class="rb-results-limit">
                <span>{{ 'decklist.browse.per_page' | trans }}</span>
                <select name="limit" form="browse-form" class="form-control input-sm" data-autosubmit>
                    {% for n in [10, 30, 50, 80, 100] %}
                        <option value="{{ n }}"{% if (f.limit ?? 50) == n %} selected{% endif %}>{{ n }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>
{% endblock %}
