{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/app.deck_editor.js') }}"></script>
    <script src="{{ asset('js/app.md_editor.js') }}"></script>
    <script src="{{ asset('js/app.deck_notes.js') }}"></script>
    <script src="{{ asset('js/ui.decklist_form.js') }}"></script>
    <script type="text/javascript">
      app.deck.init({{ decklist|json_encode|raw }});
      {% if gate is not null and not gate.ok %}
      $(function () { $('#publish-gate-modal').modal('show'); });
      {% endif %}
    </script>
{% endblock %}

{% block wrapper_class %}rb-fill{% endblock %}

{#
   The decklist form (Ketura, 2026-11-06): publishing a deck (mode 'create') and editing
   the published decklist (mode 'edit') are one page; what a mode doesn't allow is
   disabled or left out here. Laid out as the deckbuilder is (Ketura, 2026-11-07): the deck
   as it will be published on the left, read-only, with its format, legality and whether
   it's a half; the form on the right under a large title, its notice, deck name and buttons
   fixed and the rest scrolling between them. Fields outside the <form> join it with
   form="decklist-form". Its notes
   are the deckbuilder's Notes tab (Deck/notes-editor). After publishing, the release date
   changes only while the decklist is withdrawn: content_editable says so.
#}
{% block body %}
    {% import 'Tags/tags.html.twig' as tags %}
    {% set is_author = app.user and app.user.id == decklist.user.id %}
    <div class="main white container rb-builder rb-publish">
        {% include 'alerts.html.twig' %}
        <div class="row rb-builder-row">
            <!-- Left: the deck, as it is published -->
            <div class="col-md-6 rb-col-left">
                <section class="rb-info rb-publish-info" aria-label="{{ 'decklist.form.deck_label' | trans }}">
                    <div class="rb-publish-facts">
                        {{ tags.format(format, false) }}
                        {% include 'Deck/completeness-label.html.twig' with {deck: decklist} %}
                    </div>
                    {# the pill says it's legal; problems get the whole list #}
                    {% if decklist.validation is null or not decklist.validation.isValid %}
                        {% include 'Deck/validation.html.twig' with {deck: decklist} %}
                    {% endif %}
                </section>
                <div class="rb-deck-toolbar" id="deck-toolbar"></div>
                <section class="rb-deck" id="deck" aria-label="{{ 'deckbuilder.deck_label' | trans }}">
                    <div class="deck-loading"><i class="fas fa-spinner fa-spin fa-3x"></i></div>
                </section>
            </div>

            {# drag to share the width between the deck and the form (Ketura, 2026-11-07) #}
            <div class="rb-publish-splitter" id="publish-splitter" role="separator" aria-orientation="vertical" title="{{ 'decklist.form.resize' | trans }}"></div>
            <!-- Right: the form -->
            <div class="col-md-6 rb-col-right rb-publish-side">
                {# a large title, as the decklists page has (Ketura, 2026-11-07); the notice, the
                   deck name and the buttons stay put, the rest scrolls between them #}
                <h1 class="rb-browse-title rb-publish-title">{{ pagetitle }}</h1>
                <div class="rb-publish-top">
                    {# the same cards published before (Ketura, 2026-11-07: under the title) #}
                    {% if duplicate_warning %}<div class="alert alert-warning rb-duplicate-note" id="duplicate-note">{{ duplicate_warning | raw }}</div>{% endif %}
                    {% if mode == 'create' %}
                        {# what publishing means (Ketura, 2026-11-07) #}
                        <div class="alert alert-info rb-release-note" id="release-note">{{ 'decklist.form.release_note' | trans | raw }}</div>
                    {% elseif not decklist.archived %}
                        {# where the decklist stands: within the grace period, withdrawn, or fixed #}
                        {% if decklist.withdrawn %}
                            <div class="alert alert-warning rb-state" id="decklist-state" data-state="withdrawn">
                                <p>{{ 'decklist.state.withdrawn_help' | trans }}</p>
                                {% if is_author %}
                                    <div class="rb-state-actions">
                                        {% if source_deck %}
                                            <a class="btn btn-default btn-sm" href="{{ path('deck_edit', {deck_uuid: source_deck.uuid}) }}">{{ 'decklist.state.open_deck' | trans }}</a>
                                            <form class="rb-inline-form" method="post" action="{{ path('decklist_replace_cards', {decklist_id: decklist.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('decklist_state') }}">
                                                <button type="submit" class="btn btn-default btn-sm">{{ 'decklist.state.replace_cards' | trans }}</button>
                                            </form>
                                        {% else %}
                                            <span class="small">{{ 'decklist.state.no_deck' | trans }}</span>
                                        {% endif %}
                                        <form class="rb-inline-form" method="post" action="{{ path('decklist_republish', {decklist_id: decklist.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('decklist_state') }}">
                                            <button type="submit" class="btn btn-publish btn-sm">{{ 'decklist.state.republish' | trans }}</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                        {% elseif decklist.canWithdraw %}
                            <div class="alert alert-info rb-state" id="decklist-state" data-state="grace">
                                <p>{{ 'decklist.state.grace_help' | trans({'%date%': decklist.graceEnds | date('Y-m-d H:i T')}) }}</p>
                                {% if is_author %}
                                    <form class="rb-inline-form" method="post" action="{{ path('decklist_withdraw', {decklist_id: decklist.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('decklist_state') }}">
                                        <button type="submit" class="btn btn-default btn-sm">{{ 'decklist.state.withdraw' | trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="alert alert-default rb-state" id="decklist-state" data-state="fixed">
                                <p>{{ 'decklist.state.fixed_help' | trans }}</p>
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="form-group">
                        <label for="name">{{ 'decklist.form.name' | trans }}</label>
                        {# its version, between the heading and the name (Ketura, 2026-11-08): the one publishing makes, or the one it is #}
                        <p class="rb-form-version" id="version-line">{{ (mode == 'create' ? 'decklist.form.version_will_be' : 'decklist.form.version_is') | trans({'%version%': 'v' ~ decklist.fullVersion}) | raw }}</p>
                        <input type="text" class="form-control" name="name" id="name" form="decklist-form" maxlength="60" value="{{ decklist.name }}">
                    </div>
                </div>
                <form action="{{ action }}" method="post" enctype="application/x-www-form-urlencoded" id="decklist-form" class="rb-publish-scroll"
                      {%- if private_revision %} data-private-revision="{{ private_revision.version }}"{% endif %}>
                    <input type="hidden" name="_token" value="{{ csrf_token('decklist_form') }}">
                    {% if private_revision %}<input type="hidden" name="apply_to_deck" id="apply-to-deck" value="">{% endif %}

                    {#
                       The thumbnail the lists show (Ketura, 2026-11-05): a card of the deck, or the
                       culture banner. A list of its own rather than a <select> (Ketura, 2026-11-07):
                       hovering an option previews it, the wheel over it steps one at a time, and the
                       cards are in the deck list's order (ui.decklist_form.js sorts them).
                    #}
                    {% set chosen = decklist.thumbnailCard ? decklist.thumbnailCard.code : '' %}
                    {% set type_rank = {companion: 0, ally: 1, follower: 2, minion: 3, artifact: 4, possession: 5, condition: 6, event: 7} %}
                    <div class="form-group rb-thumb-field">
                        <label for="thumb-select">{{ 'decklist.publish.thumbnail' | trans }}</label>
                        <div class="rb-thumb-pick">
                            <div class="rb-thumb-preview">
                                <span id="thumb-cultures" aria-hidden="true">{% include 'Decklist/thumbnail.html.twig' with {thumb_card: false} %}</span>
                                <span class="rb-thumb rb-thumb-card" id="thumb-card" aria-hidden="true" hidden><img alt=""></span>
                                {# a card's framing can be adjusted (Ketura, 2026-11-07): the crop editor below #}
                                {% include 'Thumbnail/edit-button.html.twig' %}
                                <input type="hidden" name="thumbnail_crop" id="thumbnail_crop" value="{{ decklist.thumbnailCrop ? decklist.thumbnailCrop | json_encode : '' }}">
                            </div>
                            <div class="rb-thumb-choice">
                                <input type="hidden" name="thumbnail" id="thumbnail" value="{{ chosen }}">
                                <button type="button" class="form-control rb-thumb-select" id="thumb-select" aria-haspopup="listbox" aria-expanded="false">
                                    <span class="rb-thumb-current"></span><span class="caret" aria-hidden="true"></span>
                                </button>
                                <div class="rb-thumb-options" id="thumb-options" role="listbox" tabindex="-1" hidden>
                                    <div class="rb-thumb-option" role="option" data-value="">{{ 'decklist.publish.thumbnail_cultures' | trans }}</div>
                                    {% set slots = decklist.slots | filter(s => s.card.imageUrl) %}
                                    {% for group in [
                                        {key: 'rb', label: 'decklist.publish.thumbnail_rb' | trans, slots: slots | filter(s => s.role == 'ring_bearer' or s.role == 'ring')},
                                        {key: 'fp', label: 'side.free_peoples' | trans, slots: slots | filter(s => s.role == 'draw' and s.card.side == 'free_peoples')},
                                        {key: 'shadow', label: 'side.shadow' | trans, slots: slots | filter(s => s.role == 'draw' and s.card.side == 'shadow')},
                                        {key: 'sites', label: 'decklist.publish.thumbnail_sites' | trans, slots: slots | filter(s => s.role == 'site')},
                                    ] %}
                                        {% if group.slots | length %}
                                            <div class="rb-thumb-group" data-group="{{ group.key }}" role="presentation">{{ group.label }}</div>
                                            {% for slot in group.slots %}
                                                {% set card = slot.card %}
                                                <div class="rb-thumb-option" role="option" data-group="{{ group.key }}" data-value="{{ card.code }}"
                                                     data-image="{{ card.imageUrl }}" data-template="{{ card.thumbnailTemplate }}"
                                                     data-rank="{{ slot.role == 'ring_bearer' ? -2 : (slot.role == 'ring' ? -1 : (type_rank[card.type.code] ?? 99)) }}"
                                                     data-site="{{ card.siteNumber ?? 99 }}" data-shadow="{{ card.shadowNumber ?? 99 }}">{{ card.fullName }}</div>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# the crop editor, shared with the library editor (Ketura, 2026-11-09) #}
                    {% include 'Thumbnail/crop-dialog.html.twig' %}

                    <div class="form-group rb-release-date">
                        <label for="effective_date">{{ 'decklist.form.release_date' | trans }}</label>
                        <input type="date" class="form-control" name="effective_date" id="effective_date" value="{{ decklist.effectiveDate | date('Y-m-d') }}"{% if not content_editable %} disabled{% endif %}>
                        <span class="help-block small">{{ 'decklist.form.release_date_hint' | trans }}</span>
                    </div>

                    {# the deckbuilder's Notes tab, the same component #}
                    {% include 'Deck/notes-editor.html.twig' with {notes_tags: decklist.tags, notes_description: decklist.descriptionMd} %}

                    {#
                       Derived from (Ketura, 2026-11-07; several since 2026-11-08): search by author
                       and deck name, or paste a decklist's id or address; each pick shows as a card
                       to check it's the right one, with Remove.
                    #}
                    {% set derived_list = decklist.precedents | filter(d => not d.withdrawn) %}
                    <div class="form-group rb-derived" data-lookup="{{ path('decklist_lookup') }}" data-except="{{ decklist.id }}">
                        <label for="derived-name">{{ 'decklist.form.derived' | trans }}</label>
                        <input type="hidden" name="precedents" id="precedents" value="{{ derived_list | map(d => d.id) | join(',') }}">
                        <div class="rb-derived-chosen" id="derived-chosen">
                            {% for d in derived_list %}
                                <div class="rb-derived-pick" data-id="{{ d.id }}">
                                    <div class="rb-derived-card">{% include 'Decklist/deck-ref.html.twig' with {d: d} %}</div>
                                    <button type="button" class="btn btn-link btn-sm rb-derived-remove">{{ 'decklist.form.derived_clear' | trans }}</button>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="rb-derived-search" id="derived-search">
                            <div class="row">
                                <div class="col-sm-5"><input type="text" class="form-control" id="derived-author" autocomplete="off" placeholder="{{ 'decklist.form.derived_author' | trans }}"></div>
                                <div class="col-sm-7"><input type="text" class="form-control" id="derived-name" autocomplete="off" placeholder="{{ 'decklist.form.derived_name' | trans }}"></div>
                            </div>
                            <div class="list-group rb-derived-results" id="derived-results" hidden></div>
                        </div>
                        <span class="help-block small">{{ 'decklist.form.derived_hint' | trans }}</span>
                    </div>
                </form>
                <div class="rb-form-actions">
                    {% set blocked = gate is not null and not gate.ok %}
                    <button type="submit" class="btn btn-publish" form="decklist-form" id="decklist-submit"{% if blocked %} disabled title="{{ 'decklist.publish.gate.blocked' | trans }}"{% endif %}>{{ (mode == 'create' ? 'forms.publish' : 'forms.save') | trans }}</button>
                    <a href="{{ cancel }}" class="btn btn-default">{{ 'forms.cancel' | trans }}</a>
                </div>
            </div>
        </div>
    </div>
    {#
       Saving a changed decklist whose deck has a private revision asks whether that revision
       takes the changes too (Ketura, 2026-11-08); ui.decklist_form shows it
    #}
    {# a deck that can't be published: why, shown on arrival (Ketura, 2026-11-08; decision 0025) #}
    {% if gate is not null and not gate.ok %}
        {% include 'Decklist/publish-gate.html.twig' with {gate: gate, back: cancel} %}
    {% endif %}
    {% if private_revision %}
        <div class="modal fade" id="apply-to-deck-modal" tabindex="-1" role="dialog" aria-labelledby="apply-to-deck-title">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'forms.cancel' | trans }}"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="apply-to-deck-title">{{ 'decklist.form.apply.title' | trans }}</h4>
                    </div>
                    <div class="modal-body">
                        <p>{{ 'decklist.form.apply.text' | trans({'%version%': private_revision.version, '%deck%': private_revision.name}) }}</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'forms.cancel' | trans }}</button>
                        <button type="button" class="btn btn-default" data-apply="0">{{ 'decklist.form.apply.no' | trans }}</button>
                        <button type="button" class="btn btn-primary" data-apply="1">{{ 'decklist.form.apply.yes' | trans({'%version%': private_revision.version}) }}</button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
