{# Import decks as text: Gemp deck strings or card lists (DeckImportService) #}
{% extends 'base.html.twig' %}
{% block body %}
    <div class="main white container">
        {% include 'alerts.html.twig' %}
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <h1>{{ 'decks.import.title' | trans }}</h1>
                <p>{{ 'decks.import.intro' | trans }}</p>
                <pre class="small">My Elves
Ring-bearer: Frodo, Son of Drogo
Ring: The One Ring, The Ruling Ring
Adventure deck
Bag End
...
Free Peoples
2x Legolas, Greenleaf
...

{{ 'decks.import.or_gemp' | trans }}
1_290|1_2|1_319,1_327,...|1_50,1_50,...</pre>
                <form method="POST" action="{{ path('deck_fileimport') }}" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="target_format">{{ 'deck.target_format' | trans }}</label>
                        <select class="form-control" id="target_format" name="target_format">
                            <option value="" selected>{{ 'decks.import.guess_format' | trans }}</option>
                            {% for format in formats %}
                                <option value="{{ format.code }}">{{ format.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="content">{{ 'decks.import.paste' | trans }}</label>
                        <textarea class="form-control" id="content" name="content" rows="15"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="upfile">{{ 'decks.import.file' | trans }}</label>
                        <input type="file" id="upfile" name="upfile" accept=".txt,text/plain">
                    </div>
                    <button type="submit" class="btn btn-success">{{ 'decks.import.submit' | trans }}</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
