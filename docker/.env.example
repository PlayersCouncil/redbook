# Settings for docker compose itself and the database container.
# Copy to .env, fill in, chmod 600. Never commit the copy.

# Prefix for the project, container and image names
COMPOSE_PROJECT_NAME=redbook

# Host ports, bound to 127.0.0.1 only
APP_PORT=1300
DB_PORT=3307

# Database (MariaDB). The app builds its DATABASE_URL from these, so keep the
# passwords URL-safe (letters, digits, - and _).
DB_NAME=redbook
DB_USER=redbook
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Memory caps (docker mem_limit)
APP_MEM_LIMIT=1g
DB_MEM_LIMIT=1g

# Card data (lotrtcg-card-data) imported by "init": repository and the branch, tag
# or commit to use. Pin a commit or tag in production.
CARD_DATA_REPO=https://github.com/PlayersCouncil/lotrtcg-card-data.git
CARD_DATA_REF=main

# Development: uncomment to load docker-compose.dev.yml automatically
#COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
#MAILPIT_PORT=8025
