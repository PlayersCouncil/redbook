{# New deck: pick the format it targets (decision 0020) and a name #}
{% extends 'base.html.twig' %}
{% block body %}
    <div class="main white container">
        {% include 'alerts.html.twig' %}
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <h1>{{ 'decks.form.new' | trans }}</h1>
                {% if formats is empty %}
                    <div class="alert alert-warning">{{ 'formats.none' | trans }}</div>
                {% else %}
                    <form method="POST" action="{{ path('deck_initbuild') }}">
                        <div class="form-group">
                            <label for="target_format">{{ 'deck.target_format' | trans }}</label>
                            <select class="form-control" id="target_format" name="target_format">
                                {% for format in formats %}
                                    <option value="{{ format.code }}"{% if format.code == default_format %} selected{% endif %}>{{ format.name }}{% if format.pcErrata %} &ndash; {{ 'formats.pc_errata' | trans }}{% endif %}</option>
                                {% endfor %}
                            </select>
                            <span class="help-block">{{ 'decks.build.format_hint' | trans }} <a href="{{ path('formats') }}">{{ 'nav.formats' | trans }}</a></span>
                        </div>
                        <div class="form-group">
                            <label for="name">{{ 'decks.edit.form.name' | trans }}</label>
                            <input type="text" class="form-control" id="name" name="name" maxlength="255" placeholder="{{ 'decks.build.name_hint' | trans }}">
                        </div>
                        <button type="submit" class="btn btn-success">{{ 'decks.build.start' | trans }}</button>
                        <a href="{{ path('deck_import') }}" class="btn btn-link">{{ 'decks.import.title' | trans }}</a>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
