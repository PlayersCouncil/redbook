{# One comment in a list of comments (Ketura, 2026-11-09; shared by decklists and libraries): its
   author and date, its text; hidden ones folded away with an eye to open them.
   Variables: comment (text, user, dateCreation, isHidden, id) #}
{% import "macros.html.twig" as macros %}
<tr>
    <td id="comment-{{ comment.id }}">
        <div class="small comment-toggler" style="{% if not comment.isHidden %}display:none{% endif %}">
            <a href="#div-comment-{{ comment.id }}" data-toggle="collapse" class="text-muted pull-right"
               style="margin-left:.5em"><span class="fas fa-eye"></span></a>
        </div>
        <div class="collapse{% if not comment.isHidden %} in{% endif %}" id="div-comment-{{ comment.id }}">
            <h4 class="comment-header">
                <span class="comment-date pull-right">
                    <time datetime="{{ comment.dateCreation|date('c') }}">{{ comment.dateCreation|date('M d, Y') }}</time>
                </span>
                <span class="comment-author">{{ macros.username(comment.user) }}</span>
            </h4>
            <div class="comment-text">{{ comment.text|raw }}</div>
        </div>
    </td>
</tr>
