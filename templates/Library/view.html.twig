{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}
{#
   A library as others see it (Ketura, 2026-11-08; reworked 2026-11-09). Its header, as the
   decklist reader's, stays at the top as the page scrolls: thumbnail, name, count, tags, who
   made it, Cheers, Favourite and Comment, and Back to Top. Then, between margins: the
   description, centred; the decks as a table of contents beside the notes; the comments.
   Then the decks, a little narrower than the window: each row opens (animated) to the deck,
   drawn as the reader draws it and fetched as it opens, and the curator's commentary, with
   Previous and Next; an open row's head stays under the library's header as the deck scrolls
   by. A deck in the contents opens its row and scrolls to it.
   Variables: library, entries (LibraryEntry[], those this viewer sees), entry_data (what the
   rows show of each decklist, in the same order), can_edit, private_view, social (the viewer's
   {liked, favorite, commented}), commenters (usernames, for @ in the comment form)
#}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/app.deck_editor.js') }}"></script>
    <script src="{{ asset('js/app.md_editor.js') }}"></script>
    <script src="{{ asset('js/ui.library_view.js') }}"></script>
{% endblock %}

{# Previous and Next, above and below the commentary (Ketura, 2026-11-09) #}
{% macro step_buttons(loop) %}
    <div class="rb-lv-nav">
        <button type="button" class="rb-btn" data-step="-1"{% if loop.first %} disabled{% endif %}><span class="fas fa-chevron-up" aria-hidden="true"></span> {{ 'library.view.previous' | trans }}</button>
        <button type="button" class="rb-btn" data-step="1"{% if loop.last %} disabled{% endif %}><span class="fas fa-chevron-down" aria-hidden="true"></span> {{ 'library.view.next' | trans }}</button>
    </div>
{% endmacro %}

{% block body %}
    {% import _self as lv %}
    <div class="main white rb-library-view" data-id="{{ library.uuid }}" data-token="{{ csrf_token('library') }}" data-commenters="{{ commenters | json_encode }}"{% if app.user and app.user is same as(library.user) %} data-owner{% endif %}>
        <header class="rb-reader-head rb-lv-header" id="library-top">
            {% include 'alerts.html.twig' %}
            {% if library.visibility != 'public' %}
                <div class="alert alert-info rb-library-visibility-note">
                    <span class="fas {{ library.visibility == 'private' ? 'fa-lock' : 'fa-link' }}" aria-hidden="true"></span>
                    {{ ('library.view.note_' ~ library.visibility) | trans }}
                </div>
            {% endif %}
            <div class="rb-reader-title">
                <div class="rb-reader-name">
                    <span class="rb-lv-header-thumb">{% include 'Decklist/thumbnail.html.twig' with {decklist: library} %}</span>
                    <h1 class="rb-library-title">{{ library.name }}</h1>
                    <span class="rb-reader-version">{{ 'library.view.decks' | trans({'%count%': entries | length}) }}</span>
                    {% if library.tagList %}
                        <ul class="rb-reader-tags" aria-label="{{ 'decklist.reader.tags' | trans }}">
                            {% for tag in library.tagList %}<li><a class="rb-tag-chip" href="{{ list_path('libraries_list', {tags: [tag]}) }}">{{ tag }}</a></li>{% endfor %}
                        </ul>
                    {% endif %}
                </div>
                <div class="rb-reader-actions">
                    <div class="rb-social" role="group" aria-label="{{ 'decklist.reader.social' | trans }}">
                        {% include 'Social/buttons.html.twig' with {subject: library, kind: 'library', state: social, own: app.user and app.user is same as(library.user)} %}
                    </div>
                    <div class="rb-reader-buttons">
                        <button type="button" class="rb-btn" id="btn-back-to-top"><span class="fas fa-arrow-up" aria-hidden="true"></span> {{ 'library.view.back_to_top' | trans }}</button>
                        {% if can_edit %}
                            <a href="{{ path('library_edit', {library_uuid: library.uuid}) }}" class="rb-btn" id="btn-edit-library"><span class="fas fa-pencil-alt" aria-hidden="true"></span> {{ 'library.view.edit' | trans }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="rb-reader-meta">
                <span class="rb-reader-author">{{ macros.username(library.user) }}</span>
                {% if library.official %}<span class="rb-official-mark" title="{{ 'library.official_title' | trans }}">{{ 'library.official' | trans }}</span>{% endif %}
                <span>{{ 'library.view.updated' | trans }} <time datetime="{{ library.dateUpdate | date('Y-m-d') }}" data-absolute>{{ library.dateUpdate | date('M j, Y') }}</time></span>
            </div>
        </header>

        <div class="rb-lv-page" id="library-intro">
            {% if library.descriptionHtml %}
                <section class="rb-lv-description rb-reader-text">{{ library.descriptionHtml | raw }}</section>
            {% endif %}
            {% if entries or library.notesHtml %}
                {# the decks as a table of contents, beside the notes (Ketura, 2026-11-09) #}
                <div class="rb-lv-overview{% if not library.notesHtml %} no-notes{% endif %}">
                    {% if entries %}
                        <nav class="rb-lv-toc" aria-label="{{ 'library.view.contents' | trans }}">
                            <ol>
                                {% for entry in entries %}
                                    {% set d = entry_data[loop.index0] %}
                                    <li><a href="#deck-{{ loop.index }}" class="rb-lv-toc-link{% if not entry.available %} is-gone{% endif %}" data-row="deck-{{ loop.index }}">
                                        <span class="rb-lv-thumb">{{ d.thumb | raw }}</span>
                                        <span class="rb-lv-meta">
                                            <span class="rb-deck-name">{{ d.name }}</span>
                                            <span class="rb-deck-by">{{ d.author }} <span class="rb-deck-dot" aria-hidden="true">•</span> {{ d.version }} <span class="rb-deck-dot" aria-hidden="true">•</span> {{ d.format ?: '—' }}</span>
                                        </span>
                                    </a></li>
                                {% endfor %}
                            </ol>
                        </nav>
                    {% endif %}
                    {% if library.notesHtml %}
                        <div class="rb-lv-general-notes rb-library-notes-body rb-reader-text">{{ library.notesHtml | raw }}</div>
                    {% endif %}
                </div>
            {% endif %}
            <section class="rb-lv-comments rb-reader-comments" id="library-comments">
                {% include 'Social/comments.html.twig' with {comments: library.comments | filter(c => not c.isHidden or (app.user and app.user is same as(library.user))), count: library.nbComments} %}
                {% if not app.user %}<p class="rb-muted"><a href="{{ path('fos_user_security_login') }}">{{ 'library.view.login_to_comment' | trans }}</a></p>{% endif %}
            </section>
        </div>

        {% if entries %}
            <ol class="rb-library-list" id="library-list">
                {% for entry in entries %}
                    {% set d = entry_data[loop.index0] %}
                    <li class="rb-lv-entry rb-kind-{{ d.kind }}{% if not entry.available %} is-gone{% endif %}" id="deck-{{ loop.index }}" data-entry="{{ entry.id }}" data-url="{{ path('library_entry_deck', {entry_id: entry.id}) }}">
                        <button type="button" class="rb-lv-head" aria-expanded="false" aria-controls="deck-{{ loop.index }}-body">
                            <span class="rb-lv-num">{{ loop.index }}</span>
                            <span class="rb-lv-thumb">{{ d.thumb | raw }}</span>
                            <span class="rb-lv-meta">
                                <span class="rb-deck-name">{{ d.name }}</span>
                                <span class="rb-deck-by">{{ d.author }} <span class="rb-deck-dot" aria-hidden="true">•</span> {{ d.version }} <span class="rb-deck-dot" aria-hidden="true">•</span> {{ d.format ?: '—' }}</span>
                            </span>
                            <span class="rb-size"><span class="rb-size-fp{% if not d.fp %} is-none{% endif %}">{{ d.fp ?: '–' }}</span><span class="rb-size-slash">/</span><span class="rb-size-sh{% if not d.shadow %} is-none{% endif %}">{{ d.shadow ?: '–' }}</span></span>
                            <span class="rb-lv-has-notes"{% if not entry.annotationHtml %} hidden{% endif %} title="{{ 'library.view.has_notes' | trans }}"><span class="fas fa-comment-alt" aria-hidden="true"></span></span>
                            <span class="rb-lv-chevron fas fa-chevron-down" aria-hidden="true"></span>
                        </button>
                        <div class="rb-lv-body" id="deck-{{ loop.index }}-body">
                          <div class="rb-lv-body-inner">
                            <div class="rb-lv-deck">
                                <div class="rb-lv-flags">
                                    {{ d.flags | raw }}
                                    <a class="rb-lv-open" href="{{ d.url }}">{{ 'library.view.open' | trans }} <span class="fas fa-external-link-alt" aria-hidden="true"></span></a>
                                    {# Clone, Copy Text and Download, as the decklist's own page has them (Ketura, 2026-11-09) #}
                                    <span class="rb-reader-buttons rb-lv-tools">
                                        {% include 'Decklist/reader-copy-buttons.html.twig' with {clone_url: path('deck_copy', {decklist_id: entry.decklist.id}), download_url: path('decklist_download', {decklist_id: entry.decklist.id, format: 'text'})} %}
                                    </span>
                                </div>
                                <div class="rb-lv-deck-slot"></div>
                            </div>
                            <div class="rb-lv-notes">
                                <div class="rb-lv-notes-head">
                                    <h2 class="rb-lv-section-head">{{ 'library.view.commentary' | trans }}</h2>
                                    {{ lv.step_buttons(loop) }}
                                </div>
                                <div class="rb-reader-text">
                                    {% if entry.annotationHtml %}{{ entry.annotationHtml | raw }}{% else %}<p class="rb-muted">{{ 'library.view.no_notes' | trans }}</p>{% endif %}
                                </div>
                                {{ lv.step_buttons(loop) }}
                            </div>
                          </div>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <p class="rb-results-none rb-lv-empty">{{ 'library.view.empty' | trans }}</p>
        {% endif %}

        {# the one deck view, moved into whichever row is open #}
        <div class="rb-lv-deck-home" hidden>
            <div class="rb-deck-toolbar rb-reader-deck-opts" id="deck-toolbar"></div>
            <div class="rb-deck rb-readonly" id="deck"></div>
        </div>
    </div>
{% endblock %}
