{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}
{# Two decks side by side: what they share, then what each has alone. Variables: deck1, deck2, parts (adventure, draw => shared slots) #}
{% block body %}
    <div class="main white container">
        <div class="row">
            <div class="col-sm-6"><h3><a href="{{ path('deck_view', {deck_uuid: deck1.uuid}) }}">{{ deck1.name }}</a></h3></div>
            <div class="col-sm-6"><h3><a href="{{ path('deck_view', {deck_uuid: deck2.uuid}) }}">{{ deck2.name }}</a></h3></div>
        </div>
        {% for part, shared in parts %}
            {% set getter = part == 'adventure' ? 'sites' : 'drawDeck' %}
            <h4>{{ ('decks.compare.' ~ part) | trans }}</h4>
            <div class="row">
                <div class="col-sm-12"><h5>{{ 'decks.compare.shared' | trans }}</h5>
                    {% for slot in shared %}<div>{{ macros.slot_with_icons(slot) }}</div>{% else %}<div class="text-muted">&mdash;</div>{% endfor %}
                </div>
            </div>
            <div class="row">
                {% for deck in [deck1, deck2] %}
                    <div class="col-sm-6"><h5>{{ 'decks.compare.only_in' | trans({'%deck%': deck.name}) }}</h5>
                        {% for slot in attribute(deck.slots, getter) %}{% if slot.quantity > 0 %}<div class="diff">{{ macros.slot_with_icons(slot) }}</div>{% endif %}{% endfor %}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
