{% extends 'base.html.twig' %}
{#
   A saved deck (Ketura, 2026-11-08): the published decklist's reader (Decklist/reader.html.twig)
   without what only a decklist has, likes, versions and comments; where it came from and
   what it was published as stay.
#}
{% block meta %}
    {{ parent() }}
    <meta name="deck-name" content="{{ deck.name }}">
    <meta name="deck-version" content="{{ deck.version }}">
    <meta name="deck-format" content="{{ deck.targetFormat }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/app.deck_editor.js') }}"></script>
    <script src="{{ asset('js/app.deck_stats.js') }}"></script>
    <script src="{{ asset('js/ui.decklist.js') }}"></script>
    <script type="text/javascript">
      var Commenters = [];
      app.deck.init({{ deck|json_encode|raw }});
    </script>
{% endblock %}

{% block wrapper_class %}rb-fill{% endblock %}

{% block body %}
{% include 'Decklist/reader.html.twig' with {subject: deck, is_deck: true} %}
{% if is_owner %}{% include 'Modale/delete.html.twig' %}{% endif %}
{% endblock %}
