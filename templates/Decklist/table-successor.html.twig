{% import "macros.html.twig" as macros %}
{# What a decklist inspired; or, on a saved deck's page, what it was published as (Ketura,
   2026-11-08: successors_title, successors_none, successors_icon) #}

<table class="table table-condensed" id="table-successor">
    <thead>
    <tr>
        <th colspan="{% if successors|length %}4{% else %}1{% endif %}"><span
                    class="fas {{ successors_icon ?? 'fa-forward' }}"></span> {{ (successors_title ?? 'decklist.view.inspire.title') | trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% if successors|length %}
        {% for successor in successors %}
            {{ macros.decklist_table_row(successor) }}
        {% endfor %}
    {% else %}
        <tr>
            <td>{{ (successors_none ?? 'decklist.view.inspire.none') | trans }}</td>
        </tr>
    {% endif %}
    </tbody>
</table>
