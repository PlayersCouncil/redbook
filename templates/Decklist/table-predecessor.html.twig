{% import "macros.html.twig" as macros %}
{# what it was derived from: several decklists (Ketura, 2026-11-08), or a deck's one #}
{% set derived_list = precedents ?? (precedent ? [precedent] : []) %}
<table class="table table-condensed" id="table-predecessor">
    <thead>
    <tr>
        <th colspan="{% if derived_list %}4{% else %}1{% endif %}"><span
                    class="fas fa-backward"></span> {{ 'decklist.view.derived.title' | trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% for d in derived_list %}
        {{ macros.decklist_table_row(d) }}
    {% else %}
        <tr>
            <td>{{ 'decklist.view.derived.none' | trans }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
