{# One timeline of the deck (Ketura, 2026-11-03): saved versions and published versions
   together, newest first; app.deck_history fills it in #}
<div class="rb-history" id="history">
    <p class="text-muted small">{{ 'deckbuilder.history.intro' | trans }}</p>
    <table class="table table-condensed rb-history-table">
        <thead>
        <tr>
            <th>{{ 'decks.history.columns.date' | trans }}</th>
            <th>{{ 'decks.history.columns.version' | trans }}</th>
            <th>{{ 'decks.history.columns.changes' | trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
