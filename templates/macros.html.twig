{% macro integer_or_x(value) %}
    {% if value is null %}X{% else %}{{ value }}{% endif %}
{% endmacro %}

{% macro card_name_with_pack_no_link(card) %}
    <a class="card-tip" data-code="{{ card.code }}">{{ card.name }} <i>({{ card.pack.name }})</i></a>
{% endmacro %}

{% macro decklist_table_row(decklist) %}
    <tr>
        <td class="decklist-name">
            <a href="{{ path('decklist_detail', { 'decklist_id': decklist.id, 'decklist_name': decklist.nameCanonical|e('url') }) }}">{{ decklist.name }}</a>
        </td>
        <td><svg class="rb-ri" aria-hidden="true"><use href="#ri-cheers"/></svg> {{ decklist.nbVotes }}</td>
        <td><svg class="rb-ri" aria-hidden="true"><use href="#ri-fav"/></svg> {{ decklist.nbFavorites }}</td>
        <td><span class="fas fa-comment social-icon-comment"></span> {{ decklist.nbComments }}</td>
        <td><span class="fas fa-code-branch social-icon-version"></span> v{{ decklist.versionLabel }}</td>
    </tr>
{% endmacro %}

{% macro username(user) %}
    <a href="{{ path('user_profile_public', {user_id:user.id,user_name:user.username|e('url')}) }}"
       class="username fg-{{ user.color }}">{{ user.displayName }}</a>{% import 'Tags/tags.html.twig' as tags %}{{ tags.account(user) }}
    {% if user.role('ROLE_ADMIN') %}
        <span class="fas fa-user-tie admin" title="Administrator"></span>
    {% endif %}
    {% if not user.managed %}<small class="rb-rep" title="User Reputation">{{ user.reputation }}</small>{% endif %}
{% endmacro %}

{% macro username_colorless(user) %}
    <a href="{{ path('user_profile_public', {user_id:user.id,user_name:user.username|e('url')}) }}"
       class="username">{{ user.displayName }}</a>{% import 'Tags/tags.html.twig' as tags %}{{ tags.account(user) }}
    {% if user.role('ROLE_ADMIN') %}
        <span class="fas fa-user-tie admin" title="Administrator"></span>
    {% endif %}
    {% if not user.managed %}<small class="rb-rep" title="User Reputation">{{ user.reputation }}</small>{% endif %}
{% endmacro %}

{% macro decklist_social_icons(decklist) %}
    <span class="social-icons">
    <span class="social-icon-like" data-toggle="tooltip" data-placement="bottom"
          title="{{ 'decklist.view.social.like' | trans }}">
        <svg class="rb-ri" aria-hidden="true"><use href="#ri-cheers"/></svg> <span class="num">{{ decklist.nbVotes }}</span>
    </span>
    {# the reader's icons (Ketura, 2026-11-04), and its fires and crowns when it has any #}
    {% if decklist.nbFires is defined and decklist.nbFires %}
    <span class="social-icon-fire" data-toggle="tooltip" data-placement="bottom" title="{{ 'decklist.view.social.fire' | trans }}">
        <svg class="rb-ri" aria-hidden="true"><use href="#ri-fire"/></svg> <span class="num">{{ decklist.nbFires }}</span>
    </span>
    {% endif %}
    {% if decklist.nbCrowns is defined and decklist.nbCrowns %}
    <span class="social-icon-crown" data-toggle="tooltip" data-placement="bottom" title="{{ 'decklist.view.social.crown' | trans }}">
        <svg class="rb-ri" aria-hidden="true"><use href="#ri-crown"/></svg> <span class="num">{{ decklist.nbCrowns }}</span>
    </span>
    {% endif %}
    <span class="social-icon-favorite" data-toggle="tooltip" data-placement="bottom"
          title="{{ 'decklist.view.social.favorite' | trans }}">
        <svg class="rb-ri" aria-hidden="true"><use href="#ri-fav"/></svg> <span class="num">{{ decklist.nbFavorites }}</span>
    </span>
    <span class="social-icon-comment" data-toggle="tooltip"
          data-placement="bottom" title="{{ 'decklist.view.social.comment' | trans }}">
        <span class="fas fa-comment"></span> <span class="num">{{ decklist.nbComments }}</span>
    </span>
    <span class="social-icon-version" data-toggle="tooltip" data-placement="bottom"
          title="{{ 'decklist.view.social.version' | trans }}">
        <span class="fas fa-code-branch"></span> <span class="num">v{{ decklist.versionLabel }}</span>
    </span>
</span>
{% endmacro %}

{% macro slot_with_icons(slot) %}
    {{ slot.quantity }}x
    <a href="{{ path('cards_zoom', {card_code: slot.card.code }) }}" class="card card-tip" data-code="{{ slot.card.code }}">{% if slot.card.isUnique %}&bull;{% endif %}{{ slot.card.fullName }}</a>
    {% if slot.role == 'ring_bearer' %}<span class="label label-default">{{ 'deck.ring_bearer' | trans }}</span>{% endif %}
{% endmacro %}
