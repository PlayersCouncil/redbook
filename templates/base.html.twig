<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <title>{{ pagetitle|default('Deckbuilder') }} &middot; {{ 'site.name' | trans }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if not allow_search_engine_tracking %}
        <meta name="robots" content="noindex">
    {% endif %}
    <meta name="mobile-web-app-capable" content="yes">
    {% block meta %}{% endblock %}
    <link rel="icon" sizes="192x192" href="/icon-192.png"/>
    <link rel="apple-touch-icon" sizes="120x120" href="/icon-120.png"/>
    {% set _route = app.request.attributes.get('_route') %}
    {% set _get_params = app.request.attributes.get('_get_params')|default({}) %}
    {% set _route_params = app.request.attributes.get('_route_params')|default({})|merge(_get_params) %}
    {% if app.request.locale != "en" and _route != "" %}
        <link rel="canonical" href="{{ url(_route, _route_params|merge({'_locale': 'en'})) }}"/>
    {% endif %}
    {% if pagedescription is defined %}
        <meta name="description" content="{{ pagedescription }}">
    {% endif %}

    <link href='https://fonts.googleapis.com/css?family=Crimson+Text:400,400i,700,700i|Julius+Sans+One|Open+Sans:400,400i,700,700i|Open+Sans+Condensed:300'
          rel='stylesheet' type='text/css'>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.2/css/all.css" integrity="sha384-oS3vJWv+0UjzBfQzYUhtDYW+Pj2yciDJxpsK1OYPAYjqT085Qq/1cq5FLXAZQ7Ay" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/qtip2/2.1.1/jquery.qtip.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-markdown/2.9.0/css/bootstrap-markdown.min.css">
    <link rel="stylesheet" type="text/css"
          href="https://cdnjs.cloudflare.com/ajax/libs/cookieconsent2/3.0.3/cookieconsent.min.css"/>
    <link href="{{ asset('css/styles.css') }}" rel="stylesheet"/>
    {% block stylesheets %}{% endblock %}
</head>
<body>
{# The page is the size of the window (Ketura, 2026-11-03): the navbar and footer stay
   put and the content between scrolls, or, on pages like the deckbuilder that set
   wrapper_class to rb-fill, fills the space and lets its own panes scroll. #}
    <nav class="navbar navbar-default navbar-static-top" role="navigation">
        <div class="container">
            {% block navbar %}
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a class="navbar-brand" href="{{ path('index') }}">
                        <span class="fas fa-book"></span> {{ 'site.name' | trans }}
                    </a>
                </div>
                {# The header (Ketura, 2026-11-06): the public sections on the left, the user's own on the
                   right. Sections not built yet show greyed out, with no link. #}
                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">
                        <li><a href="{{ path('decklists_list') }}">{{ 'nav.decklists' | trans }}</a></li>
                        {# the public libraries (Ketura, 2026-11-08) #}
                        <li><a href="{{ path('libraries_list') }}">{{ 'nav.decklibrary' | trans }}</a></li>
                        {% for soon in ['nav.cardstats', 'nav.players', 'nav.events', 'nav.posts'] %}
                            <li class="disabled rb-nav-soon"><a title="{{ 'nav.notyet' | trans }}">{{ soon | trans }}</a></li>
                        {% endfor %}
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button"
                               aria-expanded="false">{{ 'nav.links' | trans }} <span class="caret"></span></a>
                            <ul class="dropdown-menu" role="menu">
                                <li><a href="https://play.lotrtcgpc.net/" rel="noopener">{{ 'nav.gemp' | trans }}</a></li>
                                <li><a href="https://wiki.lotrtcgpc.net/" rel="noopener">{{ 'nav.wiki' | trans }}</a></li>
                                <li><a href="https://forum.lotrtcgpc.net/" rel="noopener">{{ 'nav.forums' | trans }}</a></li>
                                <li><a href="https://lotrtcgpc.net/discord" rel="noopener">{{ 'nav.discord' | trans }}</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="nav navbar-nav navbar-right">
                        {# filled in by app.user.js: My Account, Admin, Logout #}
                        <li id="login">
                            <a href="#" class="disabled" title="{{ 'nav.account' | trans }}"><span class="fas fa-user"></span></a>
                        </li>
                        {# the user's own things, shown by app.user.js once logged in (Ketura, 2026-11-06) #}
                        <li class="rb-nav-private hidden"><a href="{{ path('decks_list') }}">{{ 'nav.mydecks' | trans }}</a></li>
                        <li class="rb-nav-private hidden"><a href="{{ path('my_libraries') }}">{{ 'nav.mylibraries' | trans }}</a></li>
                        <!-- locale selection -->
                        {% if _route is not empty %}
                            <li class="dropdown">
                                <a class="dropdown-toggle" data-toggle="dropdown" title="{{ 'nav.language' | trans }}">
                                    <span class="lang-sm"
                                          lang="{{ app.request.locale | default(default_locale) }}"></span>
                                    <span class="caret"></span>
                                </a>
                                <ul class="dropdown-menu">
                                    {% for supported_locale in supported_locales %}
                                        <li>
                                            <a href="{{ path(_route, _route_params|merge(_get_params)|merge({'_locale': supported_locale})) }}">
                                                <span lang="{{ supported_locale }}"
                                                      class="lang-sm lang-lbl lang-lbl-full"></span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% endif %}
                    </ul>
                </div><!--/.navbar-collapse -->
            {% endblock %}
        </div>
    </nav>
<main id="wrapper" class="{% block wrapper_class %}{% endblock %}">
    {% block body %}{% endblock %}
</main>
<footer class="hidden-print">
    <div class="container">
        {% block footer %}
            {% include 'footer.'~ app.request.locale ~'.html.twig' %}
        {% endblock %}
    </div>
</footer>
{% include 'Modale/card.html.twig' %}
<!--[if lt IE 9]>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7/html5shiv.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/respond.js/1.4.2/respond.js"></script>
<![endif]-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cookieconsent2/3.0.3/cookieconsent.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.4/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/forerunnerdb/1.4.40/fdb-all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/underscore.js/1.8.3/underscore-min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qtip2/2.1.1/jquery.qtip.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/typeahead.js/0.10.4/typeahead.jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/0.3.5/marked.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.textcomplete/0.2.2/jquery.textcomplete.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.10.6/moment-with-locales.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highcharts/4.1.7/highcharts.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-markdown/2.9.0/js/bootstrap-markdown.min.js"></script>
<script src="{{ asset('js/vendor.js') }}"></script>
<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
<script src="{{ path('fos_js_routing_js', {"callback": "fos.Router.setData"}) }}"></script>
<script src="{{ asset('bundles/bazingajstranslation/js/translator.min.js') }}"></script>
<script src="{{ asset('js/translations.js') }}"></script>

<script type="text/javascript">
  var app = {};
  moment.locale('{{ app.request.locale }}');
</script>
<script src="{{ asset('js/app.js') }}"></script>
<script>
  window.addEventListener("load", function () {
    window.cookieconsent.initialise({
      "palette": {
        "popup": {
          "background": "#000"
        },
        "button": {
          "background": "#f1d600"
        }
      }
    })
  });
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
