{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/ui.deckedit.js') }}"></script>
    <script type="text/javascript">
      app.deck && app.deck.init({{ deck|json_encode|raw }});
      app.deck_history && app.deck_history.init({{ deck.history|json_encode|raw }});
    </script>
{% endblock %}

{% block body %}
    <div class="main white container">
        {% include 'alerts.html.twig' %}
        {% if deck.isUnsaved %}
            <div class="alert alert-danger" role="alert" id="deck-unsaved-alert">
                <span class="fas fa-exclamation-triangle"></span>
                {{ 'decks.edit.unsaved' | trans }}
            </div>
        {% endif %}

        <div class="row">
            <!-- Left: the deck -->
            <div class="col-md-6">
                <form method="POST" action="{{ path('deck_save') }}" id="save_form" role="form" style="margin-bottom:1em">
                    <input type="hidden" id="deck-save-id" name="id" value="{{ deck.id }}">
                    <input type="hidden" id="deck-save-as-copy" name="copy" value="0">
                    <input type="hidden" id="deck-cancel-edits" name="cancel_edits" value="0">
                    <input type="hidden" name="content">
                    <input type="hidden" name="description">
                    <input type="hidden" name="tags">
                    <div class="form-group">
                        <label for="deck-name">{{ 'decks.edit.form.name' | trans }}</label>
                        <input type="text" class="form-control decklist-name" id="deck-name" name="name" value="{{ deck.name }}">
                    </div>
                    <div class="row">
                        <div class="col-sm-7 form-group">
                            <label for="deck-format">{{ 'deck.target_format' | trans }}</label>
                            <select class="form-control" id="deck-format" name="target_format">
                                {% set listed = false %}
                                {% for f in formats %}
                                    <option value="{{ f.code }}"{% if f.code == deck.targetFormat %} selected{% set listed = true %}{% endif %}>{{ f.name }}</option>
                                {% endfor %}
                                {% if not listed %}<option value="{{ deck.targetFormat }}" selected>{{ format ? format.name : deck.targetFormat }}</option>{% endif %}
                            </select>
                            <button type="button" class="btn btn-link btn-xs" id="btn-suggest-format">{{ 'deck.suggest_format' | trans }}</button>
                            <div id="format-suggestions" class="small"></div>
                        </div>
                        <div class="col-sm-5 form-group">
                            <label for="deck-effective-date" title="{{ 'deck.effective_date_hint' | trans }}">{{ 'deck.effective_date' | trans }}</label>
                            <input type="date" class="form-control" id="deck-effective-date" name="effective_date" value="{{ deck.effectiveDate | date('Y-m-d') }}">
                        </div>
                    </div>
                    <div class="checkbox">
                        <label><input type="hidden" name="shared" value="0"><input type="checkbox" name="shared" value="1"{% if deck.shared %} checked{% endif %}> {{ 'deck.shared' | trans }}</label>
                    </div>
                    <button type="submit" class="btn btn-success">{{ 'forms.save' | trans }}</button>
                    <button type="submit" id="btn-cancel-edits" class="btn btn-link">{{ 'decks.edit.form.cancel' | trans }}</button>
                    <button type="button" id="btn-convert-pc" class="btn btn-default btn-sm pull-right" style="display:none"
                            title="{{ 'deck.convert_hint' | trans }}">{{ 'deck.convert' | trans }}</button>
                </form>

                <div id="deck-validation" class="deck-validation"></div>
                <div id="deck" class="deck-loading">
                    <i class="fas fa-spinner fa-spin fa-5x"></i>
                </div>
            </div>

            <!-- Right: card pool and tools -->
            <div class="col-md-6">
                <div role="tabpanel">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a href="#tab-pane-build" aria-controls="tab-pane-build" role="tab" data-toggle="tab">
                                <span class="fas fa-puzzle-piece"></span> {{ 'decks.edit.tabs.build' | trans }}
                            </a>
                        </li>
                        <li role="presentation">
                            <a href="#tab-pane-infos" aria-controls="tab-pane-infos" role="tab" data-toggle="tab">
                                <span class="fas fa-edit"></span> {{ 'decks.edit.tabs.notes' | trans }}
                            </a>
                        </li>
                        <li role="presentation">
                            <a href="#tab-pane-draw" aria-controls="tab-pane-draw" role="tab" data-toggle="tab">
                                <span class="fas fa-redo-alt"></span> {{ 'decks.edit.tabs.test' | trans }}
                            </a>
                        </li>
                        <li role="presentation">
                            <a href="#tab-pane-charts" aria-controls="tab-pane-charts" role="tab" data-toggle="tab">
                                <span class="fas fa-chart-bar"></span> {{ 'decks.edit.tabs.charts' | trans }}
                            </a>
                        </li>
                        <li role="presentation">
                            <a href="#tab-pane-history" aria-controls="tab-pane-history" role="tab" data-toggle="tab" id="tab-header-history">
                                <span class="fas fa-history"></span> {{ 'decks.edit.tabs.history' | trans }}
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane active" id="tab-pane-build">
                            {% include 'Builder/tab-pane-build.html.twig' %}
                        </div>
                        <div role="tabpanel" class="tab-pane" id="tab-pane-draw">
                            {% include 'Builder/tab-pane-draw.html.twig' %}
                        </div>
                        <div role="tabpanel" class="tab-pane" id="tab-pane-charts">
                            {% include 'Builder/tab-pane-charts.html.twig' %}
                        </div>
                        <div role="tabpanel" class="tab-pane" id="tab-pane-infos">
                            {% include 'Builder/tab-pane-infos.html.twig' %}
                        </div>
                        <div role="tabpanel" class="tab-pane" id="tab-pane-history">
                            {% include 'Builder/tab-pane-history.html.twig' %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% include 'Modale/odds.html.twig' %}
{% endblock %}
