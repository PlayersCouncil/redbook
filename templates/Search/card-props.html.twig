{% import "macros.html.twig" as macros %}
{# Stats shown depend on the card type #}
<span class="card-props">
    {% if card.twilight is not null and card.type_code != 'site' %}
        {{ 'card.info.twilight' | trans }}: {{ card.twilight }}.
    {% endif %}
    {% if card.strength is not null %}{{ 'card.info.strength' | trans }}: {{ card.strength }}.{% endif %}
    {% if card.strength_mod %}{{ 'card.info.strength' | trans }}: {{ card.strength_mod }}.{% endif %}
    {% if card.vitality is not null %}{{ 'card.info.vitality' | trans }}: {{ card.vitality }}.{% endif %}
    {% if card.vitality_mod %}{{ 'card.info.vitality' | trans }}: {{ card.vitality_mod }}.{% endif %}
    {% if card.resistance is not null %}{{ 'card.info.resistance' | trans }}: {{ card.resistance }}.{% endif %}
    {% if card.resistance_mod %}{{ 'card.info.resistance' | trans }}: {{ card.resistance_mod }}.{% endif %}
    {% if card.site_number is not null %}
        {% if card.type_code == 'ally' %}{{ 'card.info.home_site' | trans }}{% else %}{{ 'card.info.site' | trans }}{% endif %}: {{ card.site_number }}{{ card.site_block ? ' ' ~ card.site_block : '' }}.
    {% endif %}
    {% if card.site_number_mod %}{{ 'card.info.site' | trans }}: {{ card.site_number_mod }}.{% endif %}
    {% if card.shadow_number is not null %}{{ 'card.info.shadow_number' | trans }}: {{ card.shadow_number }}.{% endif %}
    {% if card.signet %}{{ 'card.info.signet' | trans }}: {{ card.signet }}.{% endif %}
</span>
