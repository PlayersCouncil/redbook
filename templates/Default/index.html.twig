{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}

{% macro decklist_row(decklist) %}
    {% import "macros.html.twig" as macros %}
    <tr>
        <td>
            <a href="{{ path('decklist_detail', {decklist_id: decklist.id, decklist_name: decklist.nameCanonical}) }}">{{ decklist.name }}</a>
            <div class="small text-muted">
                {{ macros.username_colorless(decklist.user) }}
                &middot; {{ decklist.targetFormat }}
                &middot; {% for row in decklist.cultures | slice(0, 3) %}{{ row.culture.name }}{% if not loop.last %}, {% endif %}{% endfor %}
            </div>
        </td>
        <td class="text-right small">{{ macros.decklist_social_icons(decklist) }}</td>
    </tr>
{% endmacro %}

{% block body %}
    {% import _self as home %}
    <div class="main container">
        {% include 'alerts.html.twig' %}
        {% include 'banner-alerts.html.twig' %}
        <h1 class="site-title hidden-xs">{{ 'site.name' | trans }}</h1>
        <div class="site-slogan">{{ 'slogan' | trans }}</div>
    </div>

    <div class="main white container">
        <div class="row">
            <div class="col-md-6">
                <h3>{{ 'decklist.list.types.popular' | trans }}</h3>
                <table class="table table-condensed">
                    {% for decklist in popular_decklists %}{{ home.decklist_row(decklist) }}{% else %}<tr><td class="text-muted">{{ 'decklist.list.none' | trans }}</td></tr>{% endfor %}
                </table>
                <a href="{{ path('decklists_list', {sort: 'rated'}) }}">{{ 'seemore.decklists' | trans }}</a>
            </div>
            <div class="col-md-6">
                <h3>{{ 'decklist.list.types.recent' | trans }}</h3>
                <table class="table table-condensed">
                    {% for decklist in recent_decklists %}{{ home.decklist_row(decklist) }}{% else %}<tr><td class="text-muted">{{ 'decklist.list.none' | trans }}</td></tr>{% endfor %}
                </table>
                <a href="{{ path('decklists_list') }}">{{ 'seemore.decklists' | trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
