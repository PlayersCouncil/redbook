{# A seeded decklist's origin (phase3/06). Variables: source (DecklistSource), decklist #}
<div class="panel panel-default decklist-source">
    <div class="panel-heading">
        <h3 class="panel-title">{{ 'decklist.source.title' | trans({'%author%': source.legacyAuthor}) }}</h3>
    </div>
    <div class="panel-body">
        <p>
            {{ 'decklist.source.from' | trans({'%source%': source.source}) }}
            <a href="{{ source.sourceUrl }}" rel="nofollow noopener" target="_blank">{{ 'decklist.source.original' | trans }}</a>{% if source.archiveUrl %}
            &middot; <a href="{{ source.archiveUrl }}" rel="nofollow noopener" target="_blank">{{ 'decklist.source.archived' | trans }}</a>{% endif %}
            {% if source.postedDateText %}&middot; {{ 'decklist.source.posted' | trans({'%date%': source.postedDateText}) }}{% endif %}
            {% if source.formatAsWritten %}&middot; {{ 'decklist.source.format' | trans({'%format%': source.formatAsWritten}) }}{% endif %}
        </p>
        {% if source.formatGuess %}
            <p class="small text-muted">{{ 'decklist.source.format_guessed' | trans({'%format%': decklist.targetFormat}) }}
                {{ source.formatGuess.reasons | join('; ') }}.
                {% if source.formatGuess.alternatives %}{{ 'decklist.source.format_alternatives' | trans }} {{ source.formatGuess.alternatives | join(', ') }}.{% endif %}</p>
        {% endif %}
        {% if source.ratings %}
            <p class="small">{{ 'decklist.source.ratings' | trans({'%score%': source.ratings.score ?? '?', '%votes%': source.ratings.votes ?? '?', '%scale%': source.ratings.scale ?? ''}) }}</p>
        {% endif %}
        {% if source.unresolved | length %}
            <div class="alert alert-warning small">
                <strong>{{ 'decklist.source.unresolved' | trans }}</strong>
                <ul>{% for line in source.unresolved %}<li>{{ line.line }}{% if line.reason is defined and line.reason %} <em>({{ line.reason }})</em>{% endif %}</li>{% endfor %}</ul>
            </div>
        {% endif %}
        <details><summary class="small">{{ 'decklist.source.raw' | trans }}</summary><pre class="small">{{ source.rawDecklist }}</pre></details>
        {% if app.user and decklist.user.historic and not app.user.historic %}
            <p><a href="{{ path('historic_claim_form', {user_id: decklist.user.id}) }}" class="btn btn-sm btn-default">{{ 'claim.button' | trans }}</a></p>
        {% endif %}
        {% if source.comments | length %}
            <h4>{{ 'decklist.source.comments' | trans }}</h4>
            {% for comment in source.comments %}
                <div class="small archived-comment">
                    <strong>{{ comment.author ?? '?' }}</strong> {{ comment.date ?? '' }}
                    <div>{{ comment.text ?? '' }}</div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
