{# Cheers (with its fire and crown), Favourite and Comment (Ketura, 2026-11-09; the ladder,
   2026-11-11), shared by a decklist's reader and a library's view. Logged out, each leads to
   the login page. Pressed states come from the page's script (app.reactions, app.social), or
   here when given.
   Variables: subject (a Reactable with nbFavorites, nbComments); kind ('decklist' or 'library',
   for the titles); state (optional {level, favorite, commented}); own (optional: the viewer
   made it) #}
{% set state = state ?? {} %}
{% set titles = kind == 'library' ? {like: 'library.view.social.like', favorite: 'library.view.social.favorite', comment: 'decklist.view.social.comment'} : {like: 'decklist.view.social.like', favorite: 'decklist.view.social.favorite', comment: 'decklist.view.social.comment'} %}
{% set logged = is_granted('IS_AUTHENTICATED_REMEMBERED') %}
{% include 'Social/reactions.html.twig' with {counts: subject.reactionCounts, level: state.level ?? null, own: own ?? false, logged: logged, size: 'social', cheers_title: titles.like, login_url: path('fos_user_security_login')} only %}
{% if logged %}
    <button type="button" id="social-favorite" class="rb-react r-fav rb-social-btn is-favorite{% if state.favorite ?? false %} is-on{% endif %}" aria-pressed="{{ (state.favorite ?? false) ? 'true' : 'false' }}" title="{{ titles.favorite | trans }}">
        <svg class="rb-ri" aria-hidden="true"><use href="#ri-fav"/></svg><span class="num">{{ subject.nbFavorites }}</span></button>
    <a href="#comment-form" id="social-comment" class="rb-react rb-social-btn is-comment{% if state.commented ?? false %} is-on{% endif %}" title="{{ titles.comment | trans }}">
        <span class="{{ (state.commented ?? false) ? 'fas' : 'far' }} fa-comment" aria-hidden="true"></span><span class="num">{{ subject.nbComments }}</span></a>
{% else %}
    {# logged out: the buttons lead to the login page #}
    {% for social in [{key: 'favorite', react: 'fav', num: subject.nbFavorites}, {key: 'comment', react: null, num: subject.nbComments}] %}
        <a href="{{ path('fos_user_security_login') }}" class="rb-react{% if social.react %} r-{{ social.react }}{% endif %} rb-social-btn is-{{ social.key }}" title="{{ titles[social.key] | trans }}">
            {% if social.react %}<svg class="rb-ri" aria-hidden="true"><use href="#ri-{{ social.react }}"/></svg>{% else %}<span class="far fa-comment" aria-hidden="true"></span>{% endif %}<span class="num">{{ social.num }}</span></a>
    {% endfor %}
{% endif %}
