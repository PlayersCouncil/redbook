{% extends 'base.html.twig' %}

{# the avatar's chooser (Ketura, 2026-11-11): the shared one, which the library editor uses too #}
{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
      $(function () {
          var chooser = app.thumbnail.chooser('#avatar-field .rb-thumb-chooser', {{ {
              mode: user.avatarMode,
              card: user.avatarCard ? {code: user.avatarCard.code, image: user.avatarCard.imageUrl, template: user.avatarCard.thumbnailTemplate, label: user.avatarCard.fullName} : null,
              cultures: user.avatarCulture ? [{code: user.avatarCulture.code, name: user.avatarCulture.name, side: user.avatarCulture.side}] : []
          } | json_encode | raw }});
          $('#avatar-field').closest('form').on('submit', function () {
              $('#avatar').val(JSON.stringify(chooser.value()));
          });
      });
    </script>
{% endblock %}

{% block body %}

    <div class="container">

        {% include 'alerts.html.twig' %}
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title" id="title">{% if user.organization %}{{ 'user.organization.edit_title' | trans({'%name%': user.displayName}) }}{% else %}Profile{% endif %}</h3>
                    </div>
                    <div class="panel-body" id="main">

                        <form role="form" action="{{ path('user_profile_save') }}" method="POST">
                            {#
                               An organization's account (Ketura, 2026-11-09), edited by an admin: its
                               name, bio and colour. Its username addresses it (APP_OFFICIAL_ACCOUNT),
                               and it has no email, notifications or decks of its own to share.
                            #}
                            {% if user.organization %}
                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                <p class="help-block">{{ 'user.organization.edit_help' | trans({'%username%': user.username}) }}</p>
                            {% else %}
                            <div class="form-group">
                                <label>Reputation</label>
                                <p>{{ user.reputation }}</p>
                            </div>

                            <div class="form-group">
                                <label for="username">Username</label>
                                <input type="text" name="username" id="username" value="{{ user.username }}"
                                       class="form-control">
                            </div>
                            {% endif %}

                            <div class="form-group">
                                <label for="display_name">{{ 'user.display_name' | trans }}</label>
                                <input type="text" name="display_name" id="display_name" value="{{ user.rawDisplayName }}"
                                       placeholder="{{ user.username }}" maxlength="100" class="form-control">
                                <p class="help-block">{{ 'user.display_name_help' | trans }}</p>
                            </div>

                            <div class="form-group rb-avatar-field" id="avatar-field">
                                <label id="avatar-title">{{ 'user.avatar' | trans }}</label>
                                {% include 'Thumbnail/chooser.html.twig' with {
                                    subject: user.avatar, modes: ['card', 'culture', 'none'], labels: 'user.avatar_mode.',
                                    heading_id: 'avatar-title', cultures: cultures, max_cultures: 1, crop: user.avatarCrop,
                                    fallback: '<span class="rb-thumb rb-thumb-empty" aria-hidden="true"><span class="fas fa-user"></span></span>',
                                    hints: {search: 'user.avatar_search', none: 'user.avatar_none'}, empty_icon: 'fa-user'
                                } %}
                                <input type="hidden" name="avatar" id="avatar" value="">
                                <p class="help-block">{{ 'user.avatar_help' | trans }}</p>
                            </div>

                            {% if not user.organization %}
                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="text" name="email" id="email" value="{{ user.email }}"
                                       class="form-control">
                            </div>

                            {% endif %}

                            <div class="form-group">
                                <label for="resume">{% if user.organization %}{{ 'user.organization.about' | trans }}{% else %}Something about you{% endif %}</label>
                                <textarea id="resume" name="resume" class="form-control">{{ user.resume }}</textarea>
                            </div>

                            {% if not user.organization %}

                            <div class="checkbox">
                                <label>
                                    <input type="checkbox" name="notif_author" value="1"
                                           {% if user.isNotifAuthor %}checked{% endif %}>
                                    Be notified when a user comments one of your decklists
                                </label>
                            </div>

                            <div class="checkbox">
                                <label>
                                    <input type="checkbox" name="notif_commenter" value="1"
                                           {% if user.isNotifCommenter %}checked{% endif %}>
                                    Be notified when a user also comments a decklist you commented
                                </label>
                            </div>

                            <div class="checkbox">
                                <label>
                                    <input type="checkbox" name="notif_mention" value="1"
                                           {% if user.isNotifMention %}checked{% endif %}>
                                    Be notified when a user mentions you in a comment or replies to yours
                                </label>
                            </div>

                            <div class="checkbox">
                                <label>
                                    <input type="checkbox" name="share_decks" value="1"
                                           {% if user.isShareDecks %}checked{% endif %}>
                                    Share your decks.
                                </label>
                                <p class="help-block">If you check this box, the "View" page of your decks will be
                                    public instead of private. You can then send the link to your friends. If you
                                    uncheck the box, all your decks become private immediately.</p>
                            </div>
                            {% endif %}

                            <div class="form-group">
                                <label for="color">Select a faction color for your username</label>
                                {% for faction in factions %}
                                    <div class="radio">
                                        <label class="{{ faction.code }}">
                                            <input type="radio" name="user_faction_code" id="optionsRadios1"
                                                   value="{{ faction.code }}"
                                                   {% if user.color == faction.code %}checked{% endif %}>
                                            {{ faction.name }}
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>

                            <button type="submit" class="btn btn-primary">Save</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div> <!-- .container -->
    {% include 'Thumbnail/crop-dialog.html.twig' %}

{% endblock %}
