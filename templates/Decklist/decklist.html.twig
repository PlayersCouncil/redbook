{% extends 'base.html.twig' %}
{% import "macros.html.twig" as macros %}
{#
   The reader (Ketura, 2026-11-04): a published deck laid out to be taken in at a glance.
   Four columns, each scrolling on its own: tools (Stats, and Details for the metadata),
   the deck, the description with the starting setup and card notes, and the comments.
   Narrower, the tools go under the deck; on a phone the order is deck, description,
   comments, tools. The deck is the deckbuilder's renderer in its read-only mode.
   It loads in order (Ketura, 2026-11-04): the columns and the description come with the
   page; the deck, then Stats, then the comment form follow the card data, a frame apart.
#}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/app.deck_editor.js') }}"></script>
    <script src="{{ asset('js/app.deck_stats.js') }}"></script>
    <script src="{{ asset('js/ui.decklist.js') }}"></script>
    <script type="text/javascript">
      var Commenters = {{ commenters|json_encode|raw }};
      app.deck.init({{ decklist|json_encode|raw }});
      app.user.params.decklist_id = {{ decklist.id }};
    </script>
{% endblock %}

{% block wrapper_class %}rb-fill{% endblock %}

{% block body %}
<div class="rb-reader">
    <header class="rb-reader-head">
        {% include 'alerts.html.twig' %}
        {# withdrawn: only its author gets this far (Ketura, 2026-11-07) #}
        {% if decklist.withdrawn %}
            <div class="alert alert-info rb-withdrawn-note">
                {{ 'decklist.state.withdrawn_note' | trans }}
                <a class="btn btn-xs btn-default" href="{{ path('decklist_edit', {decklist_id: decklist.id}) }}">{{ 'forms.edit' | trans }}</a>
                <form class="rb-inline-form" method="post" action="{{ path('decklist_republish', {decklist_id: decklist.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('decklist_state') }}">
                    <button type="submit" class="btn btn-xs btn-success">{{ 'decklist.state.republish' | trans }}</button>
                </form>
            </div>
        {% endif %}
        {% if newer %}
            <div class="alert alert-info rb-newer-note">
                {% set newerlink %}<a href="{{ path('decklist_detail', {decklist_id: newer.id, decklist_name: newer.nameCanonical|e('url')}) }}">v{{ newer.version }}</a>{% endset %}
                {{ 'decklist.view.newer' | trans({'%link%': newerlink}) | raw }}
            </div>
        {% endif %}
        {% if decklist.unverified %}
            <div class="alert alert-warning rb-review-note">
                {{ 'decklist.review.unverified_note' | trans }}
                {% if is_granted('ROLE_HISTORIAN') and decklist.parent and decklist.user.historic %}
                    <a class="btn btn-xs btn-default" target="_blank" href="{{ path('deck_edit', {deck_uuid: decklist.parent.uuid}) }}">{{ 'historian.review.open' | trans }}</a>
                {% endif %}
            </div>
        {% endif %}
        <div class="rb-reader-title">
            <div class="rb-reader-name">
                <h1 class="decklist-name">{{ decklist.name }}</h1>
                {# its line of versions (Ketura, 2026-11-07); a menu once there's more than one #}
                {% if versions | length > 1 %}
                    <span class="dropdown rb-reader-versions">
                        <button class="rb-btn rb-btn-small dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" id="dropdownVersions"
                                title="{{ 'decklist.view.versions' | trans }}">v{{ decklist.version }} <span class="caret"></span></button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownVersions">
                            <li class="dropdown-header">{{ 'decklist.view.versions' | trans }}</li>
                            {% for other_decklist in versions %}
                                <li class="{% if other_decklist.id == decklist.id %}disabled{% endif %}">
                                    <a href="{{ path('decklist_detail', { 'decklist_id': other_decklist.id, 'decklist_name': other_decklist.nameCanonical|e('url') }) }}">v{{ other_decklist.version }} &middot; {{ other_decklist.name }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </span>
                {% else %}
                    <span class="rb-reader-version" title="{{ 'decklist.view.versions' | trans }}">v{{ decklist.version }}</span>
                {% endif %}
                {# the deck's tags, from the deck it was published from (Ketura, 2026-11-04) #}
                {% set tags = decklist.parent and decklist.parent.tags ? decklist.parent.tags | split(' ') | filter(t => t) : [] %}
                {% if tags %}
                    <ul class="rb-reader-tags" aria-label="{{ 'decklist.reader.tags' | trans }}">
                        {% for tag in tags %}<li class="rb-tag-chip">{{ tag }}</li>{% endfor %}
                    </ul>
                {% endif %}
            </div>
            <div class="rb-reader-actions">
                {# like, favourite and comment as buttons, filled once you have (Ketura, 2026-11-04) #}
                <div class="rb-social" role="group" aria-label="{{ 'decklist.reader.social' | trans }}">
                    {#
                       The fire (Ketura, 2026-11-04): a liker's super-upvote, worth FIRE_WEIGHT more
                       likes. Its slot left of Like is always kept, so nothing moves when it slides
                       out from behind Like; until then it is tucked away. A deck already on fire
                       shows its count to everyone, usable once you've liked it.
                    #}
                    {% set fire_weight = constant('App\\Entity\\PublishedDeck::FIRE_WEIGHT') %}
                    <span class="rb-fire-slot">
                        <button type="button" id="social-fire" class="rb-social-btn is-fire{{ decklist.nbFires ? '' : ' is-tucked' }}" aria-pressed="false" disabled
                                data-title-on="{{ 'decklist.reader.fire' | trans({'%count%': fire_weight}) }}" data-title-off="{{ 'decklist.reader.fire_out' | trans }}"
                                title="{{ 'decklist.reader.fire_locked' | trans }}">
                            <span class="fas fa-fire" aria-hidden="true"></span><span class="num">{{ decklist.nbFires }}</span></button>
                    </span>
                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        <button type="button" id="social-like" class="rb-social-btn is-like" aria-pressed="false" title="{{ 'decklist.view.social.like' | trans }}">
                            <span class="far fa-thumbs-up" aria-hidden="true"></span><span class="num">{{ decklist.nbVotes }}</span></button>
                        <button type="button" id="social-favorite" class="rb-social-btn is-favorite" aria-pressed="false" title="{{ 'decklist.view.social.favorite' | trans }}">
                            <span class="far fa-bookmark" aria-hidden="true"></span><span class="num">{{ decklist.nbFavorites }}</span></button>
                        <a href="#comment-form" id="social-comment" class="rb-social-btn is-comment" title="{{ 'decklist.view.social.comment' | trans }}">
                            <span class="far fa-comment" aria-hidden="true"></span><span class="num">{{ decklist.nbComments }}</span></a>
                    {% else %}
                        {# logged out: the buttons lead to the login page #}
                        {% for social in [{key: 'like', icon: 'thumbs-up', num: decklist.nbVotes}, {key: 'favorite', icon: 'bookmark', num: decklist.nbFavorites}, {key: 'comment', icon: 'comment', num: decklist.nbComments}] %}
                            <a href="{{ path('fos_user_security_login') }}" class="rb-social-btn is-{{ social.key }}" title="{{ ('decklist.view.social.' ~ social.key) | trans }}">
                                <span class="far fa-{{ social.icon }}" aria-hidden="true"></span><span class="num">{{ social.num }}</span></a>
                        {% endfor %}
                    {% endif %}
                </div>
                <div class="rb-reader-buttons" id="btn-group-decklist">{% include 'Decklist/toolbar.html.twig' %}</div>
            </div>
        </div>
        <div class="rb-reader-meta">
            <span class="rb-reader-author">{{ macros.username(decklist.user) }}</span>
            {# an archive deck's author claims it from right beside the name #}
            {% if app.user and decklist.user.historic and not app.user.historic %}
                <a href="{{ path('historic_claim_form', {user_id: decklist.user.id}) }}" class="rb-btn rb-btn-small">{{ 'claim.button' | trans }}</a>
            {% endif %}
            {% if format %}<a href="{{ path('format', {code: format.code}) }}">{{ format.name }}</a>{% endif %}
            <span>{{ 'decklist.reader.played' | trans({'%date%': decklist.effectiveDate | date('Y-m-d')}) }}</span>
            {# an archive deck wasn't published here: it was brought in from the archives #}
            <span class="text-muted">{{ (decklist.source ? 'decklist.reader.archived' : 'decklist.reader.published') | trans }} <time datetime="{{ decklist.dateCreation|date('c') }}">{{ decklist.dateCreation|date('Y-m-d') }}</time></span>
            {% include 'Deck/completeness-label.html.twig' with {deck: decklist} %}
            {% if decklist.verified and decklist.reviewedBy %}
                <span class="small text-muted rb-review-note">{{ 'decklist.review.verified_by' | trans({'%name%': decklist.reviewedBy.displayName, '%date%': decklist.reviewedAt | date('Y-m-d')}) }}</span>
            {% endif %}
            {% if duplicate %}
                {% set duplink %}<a href="{{ path('decklist_detail', { 'decklist_id': duplicate.id, 'decklist_name': duplicate.nameCanonical|e('url') }) }}">{{ duplicate.name }} v{{ duplicate.version }}</a>{% endset %}
                <small class="text-muted">{{ 'decklist.view.duplicate' | trans({'%duplicate%': duplink}) | raw }}</small>
            {% endif %}
        </div>
    </header>

    <div class="rb-reader-grid">
        {# tools: the deckbuilder's Stats, and the metadata nobody needs every time #}
        <section class="rb-reader-col rb-reader-tools is-pending" aria-label="{{ 'decklist.reader.tools' | trans }}">
            <ul class="nav nav-tabs rb-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#tab-pane-stats" aria-controls="tab-pane-stats" role="tab" data-toggle="tab">{{ 'deckbuilder.tabs.stats' | trans }}</a></li>
                <li role="presentation"><a href="#tab-pane-details" aria-controls="tab-pane-details" role="tab" data-toggle="tab">{{ 'decklist.reader.details' | trans }}</a></li>
            </ul>
            <div class="tab-content rb-reader-scroll">
                <div role="tabpanel" class="tab-pane active" id="tab-pane-stats">
                    <div class="rb-reader-loading">{{ 'decklist.reader.loading' | trans }}</div>
                    {% include 'Builder/tab-pane-stats.html.twig' %}
                </div>
                <div role="tabpanel" class="tab-pane rb-reader-details" id="tab-pane-details">
                    {% include 'Deck/validation.html.twig' with {deck: decklist, title: 'decklist.view.problems' | trans} %}
                    {% include 'Decklist/plays.html.twig' %}
                    {% if decklist.source %}{% include 'Decklist/source.html.twig' with {source: decklist.source} %}{% endif %}
                </div>
            </div>
        </section>

        <section class="rb-reader-col rb-reader-deck" aria-label="{{ 'decklist.reader.deck' | trans }}">
            <div class="rb-reader-deck-opts rb-deck-toolbar" id="deck-toolbar"></div>
            <div class="rb-reader-scroll rb-deck rb-readonly deck-loading" id="deck"><div class="rb-reader-loading">{{ 'decklist.reader.loading' | trans }}</div></div>
        </section>

        <section class="rb-reader-col rb-reader-desc" aria-label="{{ 'decklist.reader.description' | trans }}">
            {# the column's name stays put above its scrolling (Ketura, 2026-11-04) #}
            <h2 class="rb-reader-col-head">{{ 'decklist.reader.commentary' | trans }}</h2>
            {# rendered here rather than in the browser, so the column is whole on the first paint #}
            <div class="rb-reader-scroll">
                {% if reader.starting or reader.bid or reader.starting_html %}
                    <div class="rb-reader-starting" id="reader-starting">
                        <h3>{{ 'deckbuilder.notes.starting' | trans }}</h3>
                        {% if reader.starting or reader.bid %}
                            <p class="rb-starting-list">
                                {% if reader.starting %}
                                    <span class="rb-starting-label">{{ 'deckbuilder.notes.starting_fellowship' | trans }}</span>
                                    {% for card in reader.starting %}<a href="{{ card.href }}" class="rb-starting-card card-tip" data-code="{{ card.code }}">{{ card.label }}</a>{% endfor %}
                                    <span class="rb-starting-cost">{{ 'deckbuilder.notes.starting_twilight' | trans({'%cost%': reader.twilight}) }}</span>
                                {% endif %}
                                {% if reader.bid %}<span class="rb-reader-bid"><span class="rb-starting-label">{{ 'deckbuilder.notes.bid' | trans }}:</span> {{ reader.bid }}</span>{% endif %}
                            </p>
                        {% endif %}
                        {% if reader.starting_html %}<div class="rb-reader-text">{{ reader.starting_html | raw }}</div>{% endif %}
                    </div>
                {% endif %}
                <div id="deck-description" class="rb-reader-text">{{ decklist.descriptionHtml|raw }}</div>
                {% if reader.notes %}
                    <div class="rb-reader-notes" id="reader-notes">
                        <h3>{{ 'decklist.reader.card_notes' | trans }}</h3>
                        {% for note in reader.notes %}
                            <div class="rb-reader-note" data-note="{{ note.code }}">
                                <div class="rb-reader-note-card"><a href="{{ note.href }}" class="card-tip" data-code="{{ note.code }}">{{ note.label }}</a>
                                    {%- if not note.in_deck %}<span class="rb-annot-out" title="{{ 'deckbuilder.notes.not_in_deck' | trans }}">*</span>{% endif %}</div>
                                <div class="rb-reader-text">{{ note.html | raw }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </section>

        <section class="rb-reader-col rb-reader-comments" aria-label="{{ 'decklist.reader.comments' | trans }}">
            <div class="rb-reader-scroll">
                {# where the deck came from and what it led to, above the talk about it (Ketura, 2026-11-04) #}
                <div class="rb-reader-tree">
                    {% include 'Decklist/table-predecessor.html.twig' %}
                    {% include 'Decklist/table-successor.html.twig' %}
                </div>
                {% if decklist.source and decklist.source.comments | length %}{% include 'Decklist/archive-comments.html.twig' with {source: decklist.source} %}{% endif %}
                {% include 'Decklist/comments.html.twig' %}
            </div>
        </section>
    </div>
    {# the line from a card note to its card in the deck #}
    <svg class="rb-annot-link" id="annot-link" aria-hidden="true"><path d=""></path></svg>
</div>
{% include 'Decklist/export-modal.html.twig' %}
{% include 'Decklist/delete-modal.html.twig' %}
{% include 'Decklist/compare-modal.html.twig' %}
{% endblock %}
