{% extends 'base.html.twig' %}
{#
   The front page (Ketura, 2026-11-09; the design's reference/index.html): the cover band with
   the gilt-framed title and the Deck of the Day bookplate, then four feeds. Only the decks
   feed has data yet; Posts, Events and This Week in Years Past are placeholders until those
   sections are built. Deck of the Day is one listed deck, picked by the date, never a deck
   from the last week (PublishedDeckManager::findDeckOfTheDay).
#}
{% block topbar_edge %}rb-hinge{% endblock %}
{% block wrapper_class %}rb-fill rb-front{% endblock %}

{# a deck as the feeds show it, and Deck of the Day larger (Ketura, 2026-11-09); the tile is one
   link, its name stretched over whatever holds it (.rb-stretch) #}
{% macro deck_tile(decklist, format_names, name_id = null) %}
    {% import 'Tags/tags.html.twig' as tags %}
    {% set url = path('decklist_detail', {decklist_id: decklist.id, decklist_name: decklist.nameCanonical}) %}
    <div class="rb-deckrow">
        {% include 'Decklist/thumbnail.html.twig' with {decklist: decklist} %}
        {# the name on two lines (kept for it), then two lines (Ketura, 2026-11-09): who and when
           with the size, the format with the counts #}
        <a class="rb-deck-name rb-stretch-link" href="{{ url }}"{% if name_id %} id="{{ name_id }}"{% endif %}>{{ decklist.name }}</a>
        <div class="rb-deckrow-line is-split">
            <span class="rb-meta">{{ decklist.user.displayName }} · <time datetime="{{ decklist.dateCreation | date('c') }}">{{ decklist.dateCreation | date('M j, Y') }}</time></span>
            <span class="rb-size" title="{{ 'decklist.browse.col.size' | trans }}"><span class="rb-fp">{{ decklist.nbFreePeoples ?: '–' }}</span><span class="sep">/</span><span class="rb-sh">{{ decklist.nbShadow ?: '–' }}</span></span>
        </div>
        <div class="rb-deckrow-line is-split">
            <span class="rb-deckrow-line">{% if decklist.targetFormat %}{{ tags.format(format_names[decklist.targetFormat] ?? decklist.targetFormat, false) }}{% endif %}</span>
            {% include 'Social/counts.html.twig' with {subject: decklist} %}
        </div>
    </div>
{% endmacro %}

{% macro deck_row(decklist, format_names) %}
    {% import _self as home %}
    <li class="rb-stretch">{{ home.deck_tile(decklist, format_names) }}</li>
{% endmacro %}

{% block body %}
    {% import _self as home %}
    {% import 'Tags/tags.html.twig' as tags %}
    <section class="rb-cover rb-leather rb-tooled-bottom">
        <div class="rb-cover-inner{% if not dotd %} is-title-only{% endif %}">
            <div class="rb-cover-brand">
                <h1 class="rb-cover-title">{% include '_logo.svg.twig' with {label: 'site.name' | trans} %}</h1>
            </div>
            {#
               Deck of the Day (Ketura, 2026-11-09): at the right of the cover, its heading and the
               date on a plate of their own above it, and the deck as the Decks feed shows it, larger.
               The whole deck plate is the link.
            #}
            {% if dotd %}
                <div class="rb-dotd">
                    <div class="rb-dotd-label"><b>{{ 'home.dotd' | trans }}</b><time class="rb-bookplate-date" datetime="{{ 'now' | date('Y-m-d') }}" data-absolute>{{ 'now' | date('Y-m-d') }}</time></div>
                    <article class="rb-bookplate rb-stretch" aria-labelledby="dotd-name">
                        {{ home.deck_tile(dotd, format_names, 'dotd-name') }}
                    </article>
                </div>
            {% endif %}
        </div>
    </section>
    <div class="rb-front-main">
        {% include 'alerts.html.twig' %}
        {% include 'banner-alerts.html.twig' %}
        <div class="rb-feeds">
            {% embed 'Panel/panel.html.twig' with {id: 'decks', title: 'home.decks' | trans, more: {href: path('decklists_list'), label: 'home.all_decklists' | trans}} %}
                {% block panel_strip %}
                    <div class="rb-tabs" role="tablist">
                        <button type="button" role="tab" aria-selected="true" aria-controls="feed-new"><span class="fas fa-feather-alt"></span>{{ 'home.new' | trans }}</button>
                        <button type="button" role="tab" aria-selected="false" aria-controls="feed-popular"><svg class="rb-ri" aria-hidden="true"><use href="#ri-cheers"/></svg>{{ 'home.popular' | trans }}</button>
                    </div>
                {% endblock %}
                {% block panel_body %}
                    {% import 'Default/index.html.twig' as home %}
                    <ul class="rb-feed" id="feed-new" role="tabpanel">{% for decklist in recent_decklists %}{{ home.deck_row(decklist, format_names) }}{% else %}<li class="rb-meta">{{ 'decklist.list.none' | trans }}</li>{% endfor %}</ul>
                    <ul class="rb-feed" id="feed-popular" role="tabpanel" hidden>{% for decklist in popular_decklists %}{{ home.deck_row(decklist, format_names) }}{% else %}<li class="rb-meta">{{ 'decklist.list.none' | trans }}</li>{% endfor %}</ul>
                {% endblock %}
            {% endembed %}
            {# not built yet: their panels hold the place #}
            {% for feed in [{key: 'posts', icon: 'fa-scroll'}, {key: 'events', icon: 'fa-calendar-alt'}, {key: 'years_past', icon: 'fa-hourglass-half'}] %}
                {% embed 'Panel/panel.html.twig' with {id: feed.key, title: ('home.' ~ feed.key) | trans, classes: 'rb-feed-soon', body_classes: 'rb-feed-placeholder'} %}
                    {% block panel_body %}<span class="fas {{ feed.icon }}" aria-hidden="true"></span><p>{{ 'nav.notyet' | trans }}</p>{% endblock %}
                {% endembed %}
            {% endfor %}
        </div>
    </div>
{% endblock %}
