{% extends 'base.html.twig' %}

{% block title %}{{ 'search.title' | trans }}{% endblock %}

{% block body %}
    <div class="main white container">

        {% include 'alerts.html.twig' %}
        <div class="row">

            <div class="col-md-3">
                <h2>{{ 'search.setbrowse' | trans }}</h2>
                <ol>
                    {% for cycle in cards_data.allsetsdatathreaded() %}
                        <li>
                            <a href="{{ cycle['url'] }}">{{ cycle['label'] }}</a>
                            {% if cycle['packs'] is defined %}
                                <ol>
                                    {% for pack in cycle['packs'] %}
                                        <li><a href="{{ pack['url'] }}">{{ pack['label'] }}</a></li>
                                    {% endfor %}
                                </ol>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </div>

            <div class="col-md-9">

                <h1>{{ block('title') }}</h1>
                <form method="GET" action="{{ path('cards_processSearchForm') }}" role="form" style="margin-bottom:2em">

                    <fieldset>
                        <legend>{{ 'search.nametexts' | trans }}</legend>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="q">{{ 'card.info.name' | trans }}</label>
                                    <div>
                                        <input class="form-control" size="30" id="q" name="q" value="">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="x">{{ 'card.info.text' | trans }}</label>
                                    <div>
                                        <input class="form-control" size="40" id="x" name="x" value="">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="a">{{ 'card.info.flavor' | trans }}</label>
                                    <div>
                                        <input class="form-control" size="30" id="a" name="a" value="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>{{ 'card.info.culture' | trans }}</legend>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <div class="btn-group btn-group-sm" data-toggle="buttons">
                                        {% for culture in cultures %}
                                            <label class="btn btn-default active" title="{{ culture.name }}">
                                                <input type="checkbox" name="f[]" checked value="{{ culture.code }}">
                                                <span class="culture-symbol culture-{{ culture.code }}">{{ culture.name }}</span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="d">{{ 'card.info.side' | trans }}</label>
                                    <select class="form-control" name="d" id="d">
                                        <option value="">{{ 'search.any' | trans }}</option>
                                        <option value="fp">{{ 'side.free_peoples' | trans }}</option>
                                        <option value="shadow">{{ 'side.shadow' | trans }}</option>
                                        <option value="none">{{ 'search.none' | trans }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="t">{{ 'card.info.type' | trans }}</label>
                                    <select class="form-control" name="t" id="t">
                                        <option value="">{{ 'search.any' | trans }}</option>
                                        {% for type in types %}
                                            <option value="{{ type.code }}">{{ type.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="k">{{ 'card.info.subtypes' | trans }}</label>
                                    <select class="form-control" name="k" id="k">
                                        <option value="">{{ 'search.any' | trans }}</option>
                                        {% for subtype in subtypes %}
                                            <option value="{{ subtype }}">{{ subtype }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="u">{{ 'card.info.unique' | trans }}</label>
                                    <select class="form-control" name="u" id="u">
                                        <option value="">{{ 'search.any' | trans }}</option>
                                        <option value="1">{{ 'search.yes' | trans }}</option>
                                        <option value="0">{{ 'search.no' | trans }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="g">{{ 'card.info.signet' | trans }}</label>
                                    <input class="form-control" id="g" name="g" value="">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="i">{{ 'card.info.kind' | trans }}</label>
                                    <select class="form-control" name="i" id="i">
                                        <option value="">{{ 'card.kind.card' | trans }}</option>
                                        <option value="errata">{{ 'card.kind.errata' | trans }}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>{{ 'search.stats' | trans }}</legend>
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="o">{{ 'card.info.twilight' | trans }}</label>
                                    <div class="input-group">
                                        <span class="input-group-btn"><select name="oo" class="form-control" style="width:4em"><option value=":">=</option><option value="<">&lt;</option><option value=">">&gt;</option><option value="!">&ne;</option></select></span>
                                        <input class="form-control" size="2" id="o" name="o" value="">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="s">{{ 'card.info.strength' | trans }}</label>
                                    <div class="input-group">
                                        <span class="input-group-btn"><select name="so" class="form-control" style="width:4em"><option value=":">=</option><option value="<">&lt;</option><option value=">">&gt;</option><option value="!">&ne;</option></select></span>
                                        <input class="form-control" size="2" id="s" name="s" value="">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="v">{{ 'card.info.vitality' | trans }}</label>
                                    <div class="input-group">
                                        <span class="input-group-btn"><select name="vo" class="form-control" style="width:4em"><option value=":">=</option><option value="<">&lt;</option><option value=">">&gt;</option><option value="!">&ne;</option></select></span>
                                        <input class="form-control" size="2" id="v" name="v" value="">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="z">{{ 'card.info.resistance' | trans }}</label>
                                    <div class="input-group">
                                        <span class="input-group-btn"><select name="zo" class="form-control" style="width:4em"><option value=":">=</option><option value="<">&lt;</option><option value=">">&gt;</option><option value="!">&ne;</option></select></span>
                                        <input class="form-control" size="2" id="z" name="z" value="">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="n">{{ 'card.info.site' | trans }}</label>
                                    <div class="input-group">
                                        <span class="input-group-btn"><select name="no" class="form-control" style="width:4em"><option value=":">=</option><option value="<">&lt;</option><option value=">">&gt;</option><option value="!">&ne;</option></select></span>
                                        <input class="form-control" size="2" id="n" name="n" value="">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label for="h">{{ 'card.info.shadow_number' | trans }}</label>
                                    <div class="input-group">
                                        <span class="input-group-btn"><select name="ho" class="form-control" style="width:4em"><option value=":">=</option><option value="<">&lt;</option><option value=">">&gt;</option><option value="!">&ne;</option></select></span>
                                        <input class="form-control" size="2" id="h" name="h" value="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>{{ 'search.sets' | trans }}</legend>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="e">{{ 'card.info.set' | trans }}</label>
                                    <select class="form-control" name="e" id="e">
                                        <option value="">{{ 'search.any' | trans }}</option>
                                        {% for pack in packs %}
                                            <option value="{{ pack.code }}">{{ pack.label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="r">{{ 'card.info.rarity' | trans }}</label>
                                    <select class="form-control" name="r" id="r">
                                        <option value="">{{ 'search.any' | trans }}</option>{% for rarity in rarities %}
                                        <option value="{{ rarity.code }}">{{ rarity.code }}</option>{% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>{{ 'search.submit' | trans }}</legend>
                        <div class="row">
                            <div class="form-group">
                                {% include 'Search/searchoptions.html.twig' %}
                                <div class="col-sm-4">
                                    <button class="btn btn-primary" type="submit">{{ 'forms.search' | trans }}</button>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </form>

            </div>

        </div>

    </div>
{% endblock %}
