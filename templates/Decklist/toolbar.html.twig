{# The reader's buttons (Ketura, 2026-11-04): the author's Edit and, within the grace period,
   Undo Publish (Ketura, 2026-11-07); a moderator's Delete; then Copy This Deck, Copy List and
   Download Text File. On a phone the last three fold into an Actions menu. #}
<a href="{{ path('decklist_edit', {decklist_id:decklist.id}) }}" title="{{ 'decklist.view.toolbar.edit' | trans }}"
   class="rb-btn rb-btn-small decklist-edit" style="display:none">
    <span class="fas fa-pencil-alt text-primary" aria-hidden="true"></span> {{ 'forms.edit' | trans }}
</a>
<button type="button" class="rb-btn rb-btn-small decklist-withdraw" style="display:none"
        data-url="{{ path('decklist_withdraw', {decklist_id: decklist.id}) }}">
    <span class="fas fa-undo" aria-hidden="true"></span> {{ 'decklist.state.withdraw' | trans }}
</button>
<a href="#" title="Delete decklist" class="rb-btn rb-btn-small decklist-delete" style="display:none">
    <span class="fas fa-trash-alt text-danger" aria-hidden="true"></span> {{ 'forms.delete' | trans }}
</a>
<span class="rb-reader-buttons-wide">
    <a href="{{ path('deck_copy', {decklist_id:decklist.id}) }}" class="rb-btn rb-btn-small" title="{{ 'decklist.reader.copy_deck_hint' | trans }}">
        <span class="fas fa-code-branch" aria-hidden="true"></span> {{ 'decklist.reader.copy_deck' | trans }}</a>
    <button type="button" class="rb-btn rb-btn-small" data-copy-list title="{{ 'decklist.reader.copy_list_hint' | trans }}">
        <span class="far fa-copy" aria-hidden="true"></span> {{ 'decklist.reader.copy_list' | trans }}</button>
    <a href="{{ path('decklist_download', {decklist_id: decklist.id, format: 'text'}) }}" class="rb-btn rb-btn-small">
        <span class="fas fa-file-download" aria-hidden="true"></span> {{ 'decklist.reader.download' | trans }}</a>
</span>
<span class="dropdown rb-reader-buttons-narrow">
    <button type="button" class="rb-btn rb-btn-small dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        {{ 'forms.actions' | trans }} <span class="caret"></span>
    </button>
    <ul class="dropdown-menu dropdown-menu-right" role="menu">
        <li><a href="{{ path('deck_copy', {decklist_id:decklist.id}) }}"><span class="fas fa-code-branch" aria-hidden="true"></span> {{ 'decklist.reader.copy_deck' | trans }}</a></li>
        <li><a href="#" data-copy-list><span class="far fa-copy" aria-hidden="true"></span> {{ 'decklist.reader.copy_list' | trans }}</a></li>
        <li><a href="{{ path('decklist_download', {decklist_id: decklist.id, format: 'text'}) }}"><span class="fas fa-file-download" aria-hidden="true"></span> {{ 'decklist.reader.download' | trans }}</a></li>
    </ul>
</span>
