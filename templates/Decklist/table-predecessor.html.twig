{% import "macros.html.twig" as macros %}

<table class="table table-condensed" id="table-predecessor">
    <thead>
    <tr>
        <th colspan="{% if precedent %}4{% else %}1{% endif %}"><span
                    class="fas fa-backward"></span> {{ 'decklist.view.derived.title' | trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% if precedent %}
        {{ macros.decklist_table_row(precedent) }}
    {% else %}
        <tr>
            <td>{{ 'decklist.view.derived.none' | trans }}</td>
        </tr>
    {% endif %}
    </tbody>
</table>
