{% extends 'base.html.twig' %}

{% block body %}

    <div class="main white container">

        {% include 'alerts.html.twig' %}
        <div class="jumbotron background-{{ user.color }}-10">
            <h1>
                <span class="{{ user.color }}">{{ user.displayName }}</span>
                {% if user.historic %}<span class="label label-default rb-user-historic" title="{{ 'user.historic.badge_title' | trans }}">{{ 'user.historic.badge' | trans }}</span>{% endif %}
                {% if user.role('ROLE_ADMIN') %}
                    <span class="fas fa-user-tie admin" title="Administrator"></span>
                {% endif %}
                {% if not user.historic %}<small>{{ user.reputation }}</small>{% endif %}
            </h1>
            {% if user.aliases | length %}
                <p class="small">{{ 'user.aliases' | trans }}:
                    {% for alias in user.aliases %}{{ alias.name }}{% if alias.source %} <span class="text-muted">({{ alias.source }})</span>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}
            <p>
                {% if user.historic %}
                    {{ 'user.historic.intro' | trans({'%name%': user.displayName, '%source%': user.historicSource}) }}
                    {% if app.user and not app.user.historic %}
                        <a href="{{ path('historic_claim_form', {user_id: user.id}) }}" class="btn btn-sm btn-default">{{ 'claim.button' | trans }}</a>
                    {% endif %}
                {% else %}
                Member since {{ user.dateCreation|date('Y-m-d') }}.
                {% endif %}
            <div>
                {% if user.decklists|length > 1 %}
                    <a href="{{ path('decklists_list',{author:user.displayName}) }}">{{ user.decklists|length }}
                        published decklists.</a>
                {% else %}
                    {% if user.decklists|length == 1 %}
                        <a href="{{ path('decklists_list',{author:user.displayName}) }}">One published
                            decklist.</a>
                    {% else %}
                        No published decklists.
                    {% endif %}
                {% endif %}
            </div>
            <div>
                {% if user.reviews|length > 1 %}
                    <a href="{{ path('card_reviews_list_byauthor',{page:1,user_id:user.id}) }}">{{ user.reviews|length }}
                        published reviews.</a>
                {% else %}
                    {% if user.reviews|length == 1 %}
                        <a href="{{ path('card_reviews_list_byauthor',{page:1,user_id:user.id}) }}">One published
                            review.</a>
                    {% else %}
                        No published reviews.
                    {% endif %}
                {% endif %}
            </div>
            </p>
            {% if user.resume %}
                <p><em>{{ user.resume }}</em></p>
            {% endif %}
        </div>

    </div> <!-- .container -->

{% endblock %}
